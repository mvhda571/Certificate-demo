    ["Muhammad Xorazmshoh qachon vafot etdi?", "1220-yil dekabrida."],
    ["Taxt vorisi etib kim tayinlandi?", "O‘g‘li Jaloliddin."],
    ["Jaloliddin Manguberdi yillari", "1198–1231."],
    ["Jaloliddin qaysi yillarda hukmronlik qildi?", "1220–1231 — Xorazmshohlarning so‘nggi hukmdori."],
    ["Parvon jangi qachon bo‘lgan?", "1221-yilda."],
    ["Parvon jangi qayerda bo‘lgan?", "Afg‘onistonda."],
    ["Parvon jangining ahamiyati", "Mo‘g‘ullarning birinchi yirik mag‘lubiyati."],
    ["Parvondan keyin nima sodir bo‘ldi?", "O‘ljani bo‘lishda sarkardalar janjallashib, qo‘shinning bir qismi tarqaldi."],
    ["Sind daryosi bo‘yidagi jang qachon bo‘lgan?", "1221-yil 25-noyabrda."],
    ["Sind jangida Chingizxon qanday qatnashdi?", "Shaxsan katta qo‘shin bilan keldi."],
    ["Jaloliddin Sind jangidan keyin nima qildi?", "Ot bilan baland qirg‘oqdan daryoga sakrab, suzib o‘tdi."],
    ["Chingizxonning Jaloliddin haqidagi so‘zi", "«Otaga shunday o‘g‘il bo‘lishi kerak!»"],
    ["«Parvon — Parvoz, Sind — Sakrash»", "1221-yildagi ikki jangni eslatadi."]
  ],
  "21": [
