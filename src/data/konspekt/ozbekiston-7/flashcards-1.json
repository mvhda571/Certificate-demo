    ["XII asrda qoraxoniylarga kim hujum qildi?", "Qoraxitoylar."],
    ["XI–XII asrlarda «dehqon» so‘zi", "Oddiy ziroatchini anglata boshladi."],
    ["Iqto", "Xizmat evaziga beriladigan yer mulki."],
    ["Barzikor", "Ijarador dehqon."],
    ["Tuzoq: Nasr Eloqxon va Nasr II", "Nasr Eloqxon — qoraxoniy, Nasr II — somoniy hukmdor."]
  ],
  "17": [
    ["Xorazmni 995-yilda birlashtirgan", "Gurganch amiri Ma’mun ibn Muhammad."],
    ["Ma’mun qanday unvon oldi?", "Xorazmshoh."],
    ["1017-yilda Xorazm kimning qo‘liga o‘tdi?", "Mahmud G‘aznaviyning."],
    ["1040-yilda Xorazm kimga qaram bo‘ldi?", "Saljuqiylarga."],
    ["Anushteginiylar yillari", "1097–1231."],
    ["Anushteginiylar kimning avlodlari?", "Saljuqiylar noibi Anushteginning."],
    ["Qutbiddin Muhammad yillari", "1097–1127 — noib."],
    ["Xorazm mustaqilligi kimning nomi bilan bog‘liq?", "Otsiz (1127–1156)."],
    ["Takash yillari", "1172–1200."],
    ["Takash 1194-yilda nima qildi?", "Saljuqiy sulton To‘g‘rulni yengib, Eronni bo‘ysundirdi."],
    ["Alovuddin Muhammad yillari", "1200–1220."],
    ["Alovuddin Movarounnahrni kimlardan ozod qildi?", "Qoraxitoylardan (1206-yildan)."],
    ["1210-yilda Talas vodiysida kim yengildi?", "Qoraxitoylar."],
    ["Xorazmshohlar davlatidagi qo‘zg‘olonlar", "1210-yil O‘tror, 1212-yil Samarqand."],
    ["«Qo‘rqmas Ot Eldan Tashqari Aylandi»", "Qutbiddin → Otsiz → Elarslon → Takash → Alovuddin."]
  ],
  "18": [
    ["Temuchin yillari", "1155–1227."],
    ["Temuchin qachon Chingizxon deb e’lon qilindi?", "1206-yilda."],
    ["Qurultoy qayerda bo‘lgan?", "Onon daryosi bo‘yida."],
    ["Chingizxon qaysi hududni zabt etgan?", "Shimoliy Xitoyni."],
    ["Xorazmshoh elchilari Chingizxonga qachon bordi?", "1216-yilda."],
    ["Sulton Muhammad Chingizxon elchilarini qayerda qabul qildi?", "Buxoroda, 1218-yil bahorida."],
    ["Xorazmshohni nima haqorat qildi?", "Chingizxon uni «o‘g‘lim» deb atagani."],
    ["Mo‘g‘ul karvonida nechta tuya bo‘lgan?", "500 ta."],
    ["Karvonda nechta savdogar bo‘lgan?", "450 musulmon savdogar."],
    ["O‘tror hokimi", "G‘oyirxon (Inolchiq)."],
    ["G‘oyirxon savdogarlarni nimada aybladi?", "Josuslikda."],
    ["O‘tror fojiasi qachon bo‘lgan?", "1218-yilda."],
    ["Xorazmshoh Chingizxon talabiga qanday javob berdi?", "Rad etib, elchini o‘ldirtirdi."],
    ["O‘tror fojiasi nimaga bahona bo‘ldi?", "Urushga."],
    ["Xorazmshoh qo‘shinining zaifligi", "Son jihatdan ko‘p bo‘lsa ham, ichki birlik yo‘q edi."]
