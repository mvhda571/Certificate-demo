  "19": [
    ["Qo‘shinni birlashtirishni kimlar taklif qildi?", "Jaloliddin va Xo‘jand hokimi Temur Malik."],
    ["Sulton Muhammad nimadan qo‘rqdi?", "Katta qo‘shin uni taxtdan ag‘darishidan."],
    ["Xorazmshoh qanday taktika tanladi?", "Qo‘shinni shaharlarga bo‘lib yubordi — mudofaa taktikasi."],
    ["Chingizxon bosqini qachon boshlandi?", "1219-yil kuzida."],
    ["Birinchi zarba qaysi shaharga berildi?", "O‘trorga."],
    ["O‘trorni kimlar mudofaa qildi?", "G‘oyirxon va Qoracha Hojib."],
    ["O‘tror qamali qancha davom etdi?", "5 oy."],
    ["Mo‘g‘ullarga taslim bo‘lgan sarkarda", "Qoracha Hojib."],
    ["Buxoro qachon olindi?", "1220-yil fevralda."],
    ["Samarqand qamali qachon bo‘ldi?", "1220-yil martda."],
    ["Chingizxon Samarqand qamaliga qayerdan rahbarlik qildi?", "Shahar tashqarisidagi Ko‘ksaroy qasridan."],
    ["Xo‘jand mudofaasi rahbari", "Temur Malik."],
    ["Urganch qachon olindi?", "1221-yilda."],
    ["Urganch mudofaasida halok bo‘lgan shayx", "Najmiddin Kubro (1145–1221)."],
    ["«O‘-B-S-U» hiylasi", "O‘tror (1219) → Buxoro → Samarqand (1220) → Urganch (1221)."]
  ],
  "20": [
    ["Muhammad Xorazmshoh 1220-yil aprelda qayerga keldi?", "Nishopurga."],
