    { "t": 12, "q": "«Uzukning ko‘zi» dagi «ko‘z» qanday so‘z?", "o": ["Omonim", "Ko‘p ma’noli so‘z", "Paronim", "Arxaizm"], "a": 1, "e": "Ma’nolar bog‘liq." },
