    { "t": 15, "q": "«Vokzal, aeroport» qanday o‘zlashmalar?", "o": ["To‘la o‘zlashgan", "Nisbatan o‘zlashgan", "O‘zlashmagan", "O‘zlashayotgan"], "a": 1, "e": "To‘la — kitob, stol." },
