    { "t": 2, "q": "Askiya qaysi uslub janri?", "o": ["Publitsistik", "So‘zlashuv", "Badiiy", "Ilmiy"], "a": 1, "e": "Gurung, alqish, qarg‘ish ham." },
    { "t": 2, "q": "-gay qo‘shimchasi qaysi uslubga xos?", "o": ["Rasmiy", "Badiiy", "Ilmiy", "So‘zlashuv"], "a": 1, "e": "Kuygay." },
