    { "t": 5, "q": "«Girdob» romanida qanday unsurlar uchraydi?", "o": ["Faqat she’riy parchalar", "Qishloq xo‘jaligi terminlari, ilmiy ma’ruza", "Rasmiy buyruqlar", "Chet tilidagi matn"], "a": 1, "e": "Badiiy uslub uslublarni qorishtiradi." },
    { "t": 5, "q": "Badiiy uslubning nutq shakllari?", "o": ["Og‘zaki va yozma", "Nasriy va she’riy", "Rasmiy va norasmiy", "Ilmiy va ommabop"], "a": 1, "e": "Nazm va nasr." },
