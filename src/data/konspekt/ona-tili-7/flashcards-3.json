    ["Taqlid so‘zlar qaysi guruhga kiradi?", "Alohida olingan so‘zlar."],
    ["«Lapang-lapang» qanday so‘z?", "Holatga taqlid."],
    ["«Gumbur-gumbur» nimaga taqlid?", "Momaqaldiroq kabi tovushga."],
    ["Taqlid so‘zlar gapda qanday vazifada?", "Ko‘pincha hol yoki aniqlovchi."],
    ["Tovushga taqlid qaysi sezgi bilan bog‘liq?", "Eshitish bilan."]
  ],
  "34": [
