  "35": [
    ["Tayanch birliklar nima?", "Matnning mazmuniy yaxlitligini ta’minlovchi so‘z va gaplar."],
    ["Matnni qayta hikoya qilishning boshqa nomi?", "Bayon."],
    ["Bayonda nimaga asoslaniladi?", "Tayanch birliklarga."],
    ["Qayta hikoya qilishning birinchi bosqichi?", "Matnni diqqat bilan o‘qish, mavzu va asosiy fikrni aniqlash."],
    ["Ikkinchi bosqich?", "Tayanch so‘z va gaplarni belgilash."],
    ["Uchinchi bosqich?", "Reja tuzish."],
    ["To‘rtinchi bosqich?", "Reja asosida o‘z so‘zlari bilan bayon qilish."],
    ["Tasviriy matnni qayta hikoya qilishda nima saqlanadi?", "Belgilar va tasvir vositalari."],
    ["«So‘zni tonnalab olib, grammlab sotish kerak» kimning so‘zi?", "Abdulla Qahhorning."],
    ["Abdulla Qahhor hikmatining ma’nosi?", "Ko‘p o‘qib, kam va lo‘nda so‘zlash kerak."],
    ["Asosiy fikr nima?", "Matnning markaziy g‘oyasi."],
    ["Reja nima uchun kerak?", "Bayonni izchil qilish uchun."],
    ["Bayon qanday so‘zlar bilan qilinadi?", "O‘z so‘zlari bilan."],
    ["Tayanch birlik matnda qanday o‘rin tutadi?", "Asosiy o‘rin."],
    ["Mavzu va asosiy fikr qachon aniqlanadi?", "Matnni o‘qishda (birinchi bosqich)."],
    ["Qayta hikoya qilish necha bosqichdan iborat?", "To‘rtta."],
    ["Bayon qaysi nutq ko‘nikmasini rivojlantiradi?", "Og‘zaki va yozma nutqni."],
    ["Tayanch so‘zlar qanday belgilanadi?", "Asosiy fikrni tashuvchi so‘zlar ajratiladi."],
    ["Bayon va insho farqi?", "Bayon — berilgan matnni qayta hikoya qilish."],
    ["Lo‘nda so‘zlash nima?", "Qisqa va mazmunli so‘zlash."]
  ],
  "36": [
    ["Ariza nima?", "Rasmiy shaxs yoki idoraga iltimos bilan yozma murojaat."],
    ["Ariza tuzilishi?", "Kimga → kimdan → ARIZA → iltimos matni → sana → imzo."],
    ["Arizada iltimos qanday ifodalanadi?", "«...qabul qilishingizni so‘rayman»."],
    ["Tavsifnoma nima?", "Shaxsning faoliyati va fazilatlariga rasmiy baho beruvchi hujjat."],
    ["Tavsifnomani kim beradi?", "Tashkilot rahbari."],
    ["Tavsifnomada nimalar yoziladi?", "O‘qishi, qiziqishlari, yutuqlari, jamoat ishlari, xulqi."],
    ["Tavsifnoma qanday tugaydi?", "Rahbar imzosi, sana, muhr."],
    ["Tavsifnomada qaysi ibora bo‘ladi?", "«Tavsifnoma ... taqdim qilish uchun berildi»."],
    ["Ma’lumotnoma nima?", "Biror faktni tasdiqlovchi hujjat."],
    ["Ma’lumotnoma nimani tasdiqlaydi?", "Yashash joyi, o‘qish joyi va h.k."],
    ["Ma’lumotnoma tuzilishi?", "MA’LUMOTNOMA → ma’lumot → «... taqdim etish uchun berildi» → imzo, muhr."],
    ["Ishonchnoma nima?", "Boshqa shaxsga ishni o‘z nomidan bajarish huquqini berish hujjati."],
    ["Ishonchnoma qachon kerak?", "Maosh, posilka olish kabi hollarda."],
    ["Ariza va tavsifnoma farqi?", "Ariza — iltimos, tavsifnoma — baho."],
    ["Muhr qaysi hujjatlarda bo‘ladi?", "Tavsifnoma, ma’lumotnoma."],
    ["Arizada «kimga» qismida nima yoziladi?", "Lavozim, F.I.Sh."],
    ["Tavsifnomada «kimga» qismida nima yoziladi?", "Ish/o‘qish joyi, tug‘ilgan yili, millati, F.I.Sh."],
    ["Ma’lumotnomani kim imzolaydi?", "Mas’ul shaxs."],
    ["Bu hujjatlar qaysi guruhga kiradi?", "Ish qog‘ozlari."],
    ["Ishonchnomada nechta shaxs ishtirok etadi?", "Kamida ikkita (ishonuvchi va ishonchli shaxs)."]
  ],
  "37": [
