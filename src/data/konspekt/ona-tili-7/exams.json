{
  "midterm": [
    { "t": 1, "q": "Davlat tili haqidagi qonun qachon qabul qilingan?", "o": ["1991-yil 1-sentabr", "1989-yil 21-oktabr", "1992-yil 8-dekabr", "1993-yil 2-sentabr"], "a": 1, "e": "Davlat tili kuni." },
    { "t": 2, "q": "Qaysi undosh jarangli?", "o": ["p", "ng", "sh", "h"], "a": 1, "e": "b, v, g, d, j, z, y, l, m, n, r, g‘, ng." },
    { "t": 3, "q": "«Puch gaplar» birikmasida «puch» qanday ma’noda?", "o": ["O‘z ma’noda", "Ko‘chma ma’noda", "Omonim", "Antonim"], "a": 1, "e": "Ma’nosiz gap." },
    { "t": 4, "q": "«Kel — ket» qanday so‘zlar?", "o": ["Shakldosh", "Qarama-qarshi ma’noli", "Ma’nodosh", "Ko‘p ma’noli"], "a": 1, "e": "Antonimlar." },
    { "t": 5, "q": "«Kitobni ko‘p o‘qisangiz, undan ko‘p hikmat topasiz» da «undan» nima o‘rnida?", "o": ["Gap", "Kitob", "Hikmat", "O‘quvchi"], "a": 1, "e": "Olmosh ot o‘rnida." },
    { "t": 6, "q": "«O‘sha» + -ga qanday yoziladi?", "o": ["O‘shaga", "O‘shanga", "O‘shayga", "O‘shnaga"], "a": 1, "e": "n orttiriladi." },
    { "t": 7, "q": "«Siz keldingiz» da «siz» yakka shaxsga nima bildiradi?", "o": ["Kamtarlik", "Hurmat", "Ko‘plik", "Gumon"], "a": 1, "e": "Hurmat." },
    { "t": 9, "q": "«Qachon?» so‘roq olmoshi nimani so‘raydi?", "o": ["O‘rinni", "Paytni", "Sababni", "Shaxsni"], "a": 1, "e": "Payt." },
    { "t": 10, "q": "Qaysi olmosh to‘pdan ajratib ko‘rsatadi?", "o": ["Hamma", "Har bir", "Barcha", "Bari"], "a": 1, "e": "Har — ajratish." },
    { "t": 11, "q": "Gumon olmoshlari qanday yoziladi?", "o": ["Ajratib", "Qo‘shib", "Chiziqcha bilan", "Qo‘shtirnoqda"], "a": 1, "e": "Allakim, kimdir." },
    { "t": 12, "q": "«Hech qachon» qanday olmosh?", "o": ["Gumon", "Bo‘lishsizlik", "Belgilash", "So‘roq"], "a": 1, "e": "Hech so‘zi bilan." },
    { "t": 13, "q": "Sodda olmoshlar qanday yoziladi?", "o": ["Ajratib", "Qo‘shib", "Chiziqcha bilan", "Qavsda"], "a": 1, "e": "Kim, kimdir." },
    { "t": 14, "q": "Ismlarni kesim qiluvchi vositalar qanday ataladi?", "o": ["Ko‘makchilar", "Bog‘lamalar", "Yuklamalar", "Bog‘lovchilar"], "a": 1, "e": "-man, -dir, bo‘lmoq." },
    { "t": 15, "q": "«Qishloq» + egalik qanday yoziladi?", "o": ["Qishloqi", "Qishlog‘i", "Qishlogi", "Qishloqqi"], "a": 1, "e": "q → g‘." },
    { "t": 15, "q": "Sifatdoshdagi egalik qo‘shimchasi nimani bildiradi?", "o": ["Qarashlilikni", "Harakat bajaruvchisining shaxs-sonini", "Ko‘plikni", "Xoslikni"], "a": 1, "e": "Bilganim — men bilgan." },
    { "t": 16, "q": "Jo‘nalish kelishigi qaysi so‘roqlarga javob beradi?", "o": ["Kimning?", "Kimga? qayerga?", "Kimdan?", "Kimni?"], "a": 1, "e": "-ga (-ka, -qa)." },
    { "t": 18, "q": "Qaralmish odatda qanday qo‘shimcha oladi?", "o": ["Ko‘plik", "III shaxs egaligi", "Kelishik", "Daraja"], "a": 1, "e": "Vatanning kelajagi." },
    { "t": 19, "q": "Tushum kelishigidagi so‘z gapda qanday bo‘lak?", "o": ["Ega", "Vositasiz to‘ldiruvchi", "Hol", "Aniqlovchi"], "a": 1, "e": "O‘timli fe’lga bog‘lanadi." },
    { "t": 22, "q": "«Nondan oldi» va «nonni oldi» farqi nima?", "o": ["Farqi yo‘q", "Birinchisi — bir qismi, ikkinchisi — aniq narsa", "Birinchisi ko‘plik", "Ikkinchisi so‘roq"], "a": 1, "e": "Chiqish va tushum kelishigi." },
    { "t": 23, "q": "«U o‘qituvchi edi» da bog‘lama qaysi?", "o": ["U", "Edi", "O‘qituvchi", "Yo‘q"], "a": 1, "e": "To‘liqsiz fe’l." }
  ],
  "final": [
    { "t": 1, "q": "Og‘zaki va yozma ko‘rinishga ega bo‘lgan tushuncha qaysi?", "o": ["Alifbo", "Nutq", "Grammatika", "Lug‘at"], "a": 1, "e": "Tilning amalda qo‘llanishi." },
    { "t": 5, "q": "Qaysi biri belgilash olmoshi?", "o": ["Kimdir", "Ba’zi", "Hech kim", "Men"], "a": 1, "e": "Hamma, barcha, har bir, ba’zi." },
    { "t": 7, "q": "«Sen» + -niki qanday yoziladi?", "o": ["Senniki", "Seniki", "Senki", "Senikki"], "a": 1, "e": "Bitta n tushadi." },
    { "t": 8, "q": "«O‘zlari» qaysi shaxsda?", "o": ["I shaxs", "III shaxs ko‘plik (hurmat)", "II shaxs", "I shaxs ko‘plik"], "a": 1, "e": "O‘zlik olmoshi." },
    { "t": 13, "q": "«Uncha-muncha» qanday olmosh?", "o": ["Juft", "Takroriy", "Qo‘shma", "Sodda"], "a": 1, "e": "Tovush o‘zgarishi bilan takror." },
    { "t": 15, "q": "Qaysi so‘zga egalik qo‘shilganda k o‘zgarmaydi?", "o": ["Terak", "Nok", "Yurak", "Kurak"], "a": 1, "e": "Bir bo‘g‘inli so‘z." },
    { "t": 17, "q": "Ot-kesim qaysi kelishikda bo‘ladi?", "o": ["Tushum", "Bosh", "Qaratqich", "Chiqish"], "a": 1, "e": "Poytaxti — Toshkent." },
    { "t": 20, "q": "«Kechga qaytamiz» da «kechga» qanday bo‘lak?", "o": ["O‘rin holi", "Payt holi", "To‘ldiruvchi", "Ega"], "a": 1, "e": "Qachon?" },
    { "t": 21, "q": "«Maktabda o‘qiyman» da «maktabda» qanday bo‘lak?", "o": ["Payt holi", "O‘rin holi", "To‘ldiruvchi", "Aniqlovchi"], "a": 1, "e": "Qayerda?" },
    { "t": 24, "q": "Mustaqil so‘zlarning belgisi qaysi?", "o": ["Faqat bog‘laydi", "So‘roqqa javob beradi va gap bo‘lagi bo‘ladi", "Atash ma’nosi yo‘q", "Faqat qo‘shimcha"], "a": 1, "e": "Yordamchi so‘zlarda bu belgilar yo‘q." },
    { "t": 25, "q": "Vazifadosh ko‘makchi birikkan so‘z bilan nechta so‘roqqa javob beradi?", "o": ["Ikki", "Bitta", "Uch", "Javob bermaydi"], "a": 1, "e": "Maktab oldida — qayerda?" },
    { "t": 25, "q": "«Keyin» qaysi turkumdan o‘tgan ko‘makchi?", "o": ["Otdan", "Ravishdan", "Fe’ldan", "Sifatdan"], "a": 1, "e": "Oldin, avval, so‘ng ham." },
    { "t": 26, "q": "Qaysi ko‘makchi jo‘nalish kelishigini talab qiladi?", "o": ["Bilan", "Muvofiq", "Keyin", "Kabi"], "a": 1, "e": "Ko‘ra, qaramay, doir." },
    { "t": 26, "q": "«Tufayli» ko‘makchisi qanday ma’no beradi?", "o": ["Mavzu", "Sabab", "O‘xshatish", "Chegara"], "a": 1, "e": "Sababli, uchun ham." },
    { "t": 27, "q": "Qaysi biri vazifadosh bog‘lovchi?", "o": ["Va", "Ham", "Lekin", "Biroq"], "a": 1, "e": "Ham, bilan, -u, -da." },
    { "t": 28, "q": "Takror ayiruv bog‘lovchisi oldidan nima qo‘yiladi?", "o": ["Nuqta", "Vergul", "Tire", "Hech narsa"], "a": 1, "e": "Goh yomg‘ir, goh qor." },
    { "t": 28, "q": "«Balki» qanday vazifada keladi?", "o": ["Biriktiruv", "Zidlov", "Ayiruv", "Inkor"], "a": 1, "e": "Zidlov bog‘lovchisi vazifasida." },
    { "t": 29, "q": "Qaysi ergashtiruvchi bog‘lovchidan oldin doimo vergul qo‘yiladi?", "o": ["Agar", "Ya’ni", "Garchi", "Basharti"], "a": 1, "e": "Aniqlov bog‘lovchisi." },
    { "t": 30, "q": "-da yuklama bo‘lganda o‘rniga ko‘pincha nima qo‘yish mumkin?", "o": ["Va", "Ham", "Lekin", "Chunki"], "a": 1, "e": "«Va» qo‘yilsa — bog‘lovchi." },
    { "t": 30, "q": "Qaysi biri o‘xshatish yuklamasi?", "o": ["Faqat", "Xuddi", "Hatto", "Sira"], "a": 1, "e": "Go‘yo, naq ham." },
    { "t": 31, "q": "«Siz-chi?» da -chi qanday yozilgan?", "o": ["Qo‘shib", "Chiziqcha bilan", "Ajratib", "Qavsda"], "a": 1, "e": "-chi, -a, -ya — chiziqcha." },
    { "t": 31, "q": "Inkor yuklamali gapda kesim asosan qanday bo‘ladi?", "o": ["Tasdiq", "Inkor", "So‘roq", "Buyruq"], "a": 1, "e": "Sira unutmayman." },
    { "t": 32, "q": "Qaysi biri his-hayajon undovi?", "o": ["Kisht", "Voy", "Chu", "Pish-pish"], "a": 1, "e": "Oh, voy, uf, iye." },
    { "t": 33, "q": "«Gurs-gurs» qanday taqlid so‘z?", "o": ["Holatga taqlid", "Tovushga taqlid", "Undov", "Modal"], "a": 1, "e": "Eshitiladigan tovush." },
    { "t": 34, "q": "«Attang» qanday modal so‘z?", "o": ["Ishonch", "Afsuslanish", "Gumon", "Xulosa"], "a": 1, "e": "Afsuski, koshki ham." },
    { "t": 34, "q": "Tasdiq so‘zlari qaysilar?", "o": ["Yo‘q, mutlaqo", "Ha, xo‘p, mayli", "Albatta, shubhasiz", "Ehtimol, shekilli"], "a": 1, "e": "Dialogda -mi li savolga javob." },
    { "t": 35, "q": "Qayta hikoya qilish necha bosqichdan iborat?", "o": ["Ikki", "To‘rt", "Uch", "Besh"], "a": 1, "e": "O‘qish, tayanch, reja, bayon." },
    { "t": 36, "q": "Tavsifnoma qanday tugaydi?", "o": ["Faqat sana", "Rahbar imzosi, sana, muhr", "Iltimos bilan", "Savol bilan"], "a": 1, "e": "Rasmiy hujjat." },
    { "t": 36, "q": "Arizaning oxirgi qismida nima bo‘ladi?", "o": ["Sarlavha", "Sana va imzo", "Muhr", "Tavsif"], "a": 1, "e": "Kimga → kimdan → ARIZA → matn → sana, imzo." },
    { "t": 37, "q": "Atash ma’nosiga ega bo‘lmagan, gap bo‘lagi bo‘lmaydigan so‘zlar qanday ataladi?", "o": ["Mustaqil so‘zlar", "Yordamchi so‘zlar", "Ismlar", "Olmoshlar"], "a": 1, "e": "Ko‘makchi, bog‘lovchi, yuklama." }
