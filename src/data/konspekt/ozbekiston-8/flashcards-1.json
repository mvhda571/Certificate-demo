    ["Bekni kim tayinlagan?", "Amir."],
    ["Qishloqni kim boshqargan?", "Oqsoqol."],
    ["Amirlik boshqaruv tizimi nimalardan iborat edi?", "Devonxona, qozilik, mirshablik va harbiy idoralardan."],
    ["Amirlik mansablari — hiyla", "Xonlikda Otaliq birinchi, amirlikda Qo‘shbegi («O → Q»); «Mirshab — mir + shab (tun)»."]
  ],
  "17": [
    ["Buxoro amirligida harbiy islohot qachon o‘tkazildi?", "1837-yilda."],
    ["1837-yilgi harbiy islohotni kim o‘tkazdi?", "Amir Nasrullo."],
    ["Sarboz", "Muntazam piyoda askar."],
    ["Navkar", "Muntazam otliq askar."],
    ["To‘pchi", "Artilleriyachi."],
    ["Qora cherik", "Urush paytida aholidan to‘planadigan lashkar."],
    ["Qora cherikka chaqiruv qanday e’lon qilingan?", "Farmon bozorlarda e’lon qilinib, ro‘yxat osib qo‘yilgan."],
    ["Dastlab nechta sarboz bo‘lgan?", "800 kishi."],
    ["Dastlab nechta to‘pchi bo‘lgan?", "250 kishi."],
    ["Navkariya", "Buxoro amirligidagi muntazam qo‘shin nomi."],
    ["Muntazam qo‘shin askarlari nima olgan?", "Maosh va yagona kiyim."],
    ["Islohot doirasida qanday ustaxona tashkil etildi?", "To‘plar quyish ustaxonasi."],
    ["Buxoro amirligida oliy bosh qo‘mondon?", "Amir."],
    ["Buxoro qo‘shinining asosiy kamchiligi?", "Qurol-yarog‘ va tayyorgarlikda Rossiya armiyasidan orqada edi."],
    ["Qo‘shin turlari — hiyla", "«S-N-T»: Sarboz — piyoda, Navkar — ot, To‘pchi — to‘p."]
  ],
  "18": [
    ["Amirlikdagi yer egaligi shakllari?", "Davlat (amlok), mulk, vaqf."],
    ["Amlok yerlar", "Dehqonlar ishlab, xiroj to‘laydigan davlat yerlari."],
    ["Suvsiz dasht va to‘qayzorlar kimga berilgan?", "Ko‘chmanchi jamoalarga."],
    ["Mang‘itlar davrida suyurg‘ol egasining majburiyatlari?", "Xiroj to‘lash va qora cherigi bilan urushda qatnashish."],
    ["Mang‘itlar davrida qaysi yer in’om etish kuchaydi?", "Tanho."],
    ["Tanhodor nimaga ega bo‘lgan?", "Mansabiga qarab yerdan olinadigan soliqning bir qismiga."],
    ["Eng kichik tanho hajmi?", "36–60 tanob (3–5 gektar)."],
    ["Tanob", "Yer o‘lchov birligi (~0,1 ga)."],
    ["Mang‘itlar davrida dehqon jamoalari bilan nima bo‘ldi?", "Tugatildi."],
    ["Ijarachi dehqon", "Yerni ijaraga olib ishlovchi dehqon."],
    ["Hashar", "Majburiy jamoat mehnati (ariq qazish, qurilish)."],
    ["Dehqonning asosiy mehnat qurollari?", "Omoch, ketmon, o‘roq."],
    ["Amirlikdagi to‘qimachilik mahsulotlari?", "Ipak, kimxob, adras."],
    ["Hunarmandlar qanday birlashgan?", "Kasbiy uyushmalarga."],
    ["Mang‘itlar davri — hiyla", "«Tanho ko‘paydi, Jamoa yo‘qoldi»; eng kichik tanho — 3–5 gektar."]
  ],
  "19": [
    ["Buxoro qachondan qachongacha poytaxt bo‘lgan?", "1533–1920-yillar."],
    ["Buxoro shahrining nechta darvozasi bo‘lgan?", "11 ta."],
    ["Tim", "Yopiq bozor."],
    ["Samarqandning obodonchiligi qachon boshlangan?", "1780-yildan (Shohmurod davrida)."],
    ["Samarqand qachon shahar yo‘siniga kirgan?", "1809-yillarda."],
    ["XVIII asrda Samarqand nega huvillab qolgan?", "Ichki urushlar va ko‘chmanchilar hujumi tufayli."],
    ["Amirlikning boshqa shaharlari?", "Qarshi, Shahrisabz, Karmana, G‘ijduvon, Kattaqo‘rg‘on, Termiz, Hisor."],
    ["Amirlikning asosiy savdo hamkori?", "Rossiya."],
    ["Buxorodan Rossiyaga chiqarilgan tovarlar?", "Paxta, ip, ipak, gazlama, qorako‘l teri, quruq meva."],
    ["Rossiyadan keltirilgan tovarlar?", "Metall, chit, qand, buyumlar."],
    ["Orenburgda Buxoro savdogarlari qarorgohi qachon qurildi?", "1804-yilda."],
    ["Amirlik qaysi davlatlar bilan savdo qilgan?", "Rossiya, Eron, Afg‘oniston, Hindiston, Xitoy (Qashqar)."],
    ["Savdo qanday amalga oshirilgan?", "Karvon yo‘llari orqali (tuya karvonlari)."],
    ["Buxoro necha yil poytaxt bo‘lgan?", "387 yil."],
    ["Shaharlar — hiyla", "«Buxoro poytaxt — 1533 dan 1920 gacha»; «Orenburg — 1804»."]
  ],
  "20": [
    ["Buxoro va Xiva qaysi shahar uchun kurashgan?", "Marv uchun."],
    ["Xiva Marvni qachon egalladi?", "1845-yilda."],
    ["Buxoro va Qo‘qon qaysi hududlar uchun kurashgan?", "Xo‘jand va O‘ratepa uchun."],
    ["Polvonquli qurchi elchiligi qachon bo‘ldi?", "1797-yilda (Rossiyaga)."],
    ["Polvonquli qurchini kim yuborgan?", "Amir Shohmurod."],
    ["1858-yilgi Rossiya elchiligi rahbari?", "Polkovnik N. Ignatyev."],
    ["«Katta o‘yin»", "Angliya va Rossiyaning O‘rta Osiyo uchun raqobati."],
    ["1825-yilgi ingliz ekspeditsiyasi rahbari?", "U. Murkroft."],
    ["1832-yilda Buxoroga kelgan ingliz?", "Aleksandr Byorns."],
    ["Aleksandr Byorns o‘zini kim deb tanishtirgan?", "Arman savdogari deb."],
    ["Britaniya Afg‘onistonga qachon urush boshladi?", "1839-yilda."],
    ["Buxoroda qatl etilgan ingliz zobitlari?", "Stoddart va Konolli (1842)."],
    ["Stoddart va Konolli nimada ayblangan?", "Josuslikda."],
    ["Ignatyev elchiligining maqsadi?", "Savdo imtiyozlari va rus savdogarlari xavfsizligi."],
    ["Elchilar — hiyla", "«Byorns — Britaniya (B-B), Ignatyev — Imperiya (Rossiya)»."]
  ]
}
