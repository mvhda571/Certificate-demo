  "final": [
    { "t": 1, "q": "Milliy adabiyot nimani aks ettiradi?", "o": ["Faqat tarixni", "Milliy ruhni", "Faqat tabiatni", "Chet el hayotini"], "a": 1, "e": "Adabiyoti yo‘q millat unutilib ketadi." },
    { "t": 2, "q": "Barchinning shartlari qaysilar?", "o": ["Nard, shatranj, kurash", "Poyga, nishona, kurash", "Ajdarni o‘ldirish, ariq qazish", "Topishmoq, qo‘shiq, raqs"], "a": 1, "e": "Kurashda Alpomish Ko‘kaldoshni yengadi." },
    { "t": 2, "q": "Fitnachi Surxayil kampir qaysi dostonda?", "o": ["«Kuntug‘mish»", "«Alpomish»", "«Ravshan»", "«Farhod va Shirin»"], "a": 1, "e": "Qalmoq yurtida fitna qiladi." },
    { "t": 3, "q": "«Farhod va Shirin» qaysi vaznda yozilgan?", "o": ["Ramali musammani mahzuf", "Hazaji musaddasi mahzuf", "Mutaqoribi musammani", "Barmoq"], "a": 1, "e": "5782 bayt." },
    { "t": 3, "q": "Xusravni kim o‘ldiradi?", "o": ["Farhod", "O‘g‘li Sheruya", "Mehinbonu", "Shirin"], "a": 1, "e": "Nafs lashkari bir-birini yo‘q qiladi." },
    { "t": 4, "q": "Xojaning qaysi g‘azali Boburga yuborilgan?", "o": ["«Ustina» radifli", "«Kechadur» radifli", "«Eshit» radifli", "«Oqibat» radifli"], "a": 1, "e": "Radif bir necha ma’noda — tajnis va takrir." },
    { "t": 4, "q": "Sulaymon, pashsha va yel hikoyatining g‘oyasi nima?", "o": ["Kuchli doim haq", "Adolat — da’vogar va javobgarni teng tinglash", "Pashsha zaif", "Yel — erkinlik"], "a": 1, "e": "Pashsha yel kelganda qochib ketadi." },
    { "t": 5, "q": "Ham yonga, ham yuqoridan pastga bir xil o‘qiladigan she’r qanday ataladi?", "o": ["Muashshar", "Musoviy-ut-tarafayn", "Mustazod", "Muxammas"], "a": 1, "e": "Ogahiy ijodida uchraydi." },
    { "t": 5, "q": "Ogahiyning devoni kimning taklifi bilan tuzilgan?", "o": ["Munisning", "Feruzning (Muhammad Rahimxon Soniy)", "Navoiyning", "Erniyozbekning"], "a": 1, "e": "«Ta’viz ul-oshiqin»." },
    { "t": 6, "q": "«Kashmirda» g‘azalining maqta’sida «Furqat» so‘zi qaysi san’atni hosil qiladi?", "o": ["Tazod", "Iyhom", "Tashbih", "Ishtiqoq"], "a": 1, "e": "Ham taxallus, ham «ayriliq»." },
    { "t": 6, "q": "Mumtoz she’riyatda may, sharob, boda nimaning ramzi?", "o": ["Ko‘ngilning", "Ishq, muhabbatning", "G‘amning", "Boylikning"], "a": 1, "e": "Shisha, ko‘za, kosa — ko‘ngil ramzi." },
    { "t": 7, "q": "«Sahihi Buxoriy»ning birinchi bobi nima haqida?", "o": ["Ilm", "Iymon", "Namoz", "Odob"], "a": 1, "e": "Ikkinchisi — ilm haqida." },
    { "t": 7, "q": "Sahobalar aytgan hikmatlar qanday ataladi?", "o": ["Hadis", "Asar (osor)", "Sanad", "Matn"], "a": 1, "e": "Hadis — Payg‘ambarimiz so‘zlari." },
    { "t": 8, "q": "Oybekning umr yo‘ldoshi kim?", "o": ["Zulfiya", "Zarifa Saidnosirova", "Saida Zunnunova", "Shahodatbonu"], "a": 1, "e": "Kimyogar olima." },
    { "t": 9, "q": "Abdullatif tushida nimani ko‘radi?", "o": ["Otasining kulib turganini", "Oltin barkashda o‘z boshini", "Samarqandning yonishini", "Rasadxonani"], "a": 1, "e": "Qilmishning ruhiy jazosi." },
    { "t": 9, "q": "Ulug‘bekka qarshi qasos da’vosi bilan kim chiqadi?", "o": ["Burhoniddin", "Sayid Abbos", "Sulton Jondor", "Iskandar barlos"], "a": 1, "e": "Ulug‘bek fojiali halokatga yuz tutadi." },
    { "t": 10, "q": "«Sohibqiron»da davlatning uch tayanchi qaysilar?", "o": ["Ilm, din, savdo", "Mo‘l xazina, yagona shoh, yengilmas lashkar", "Qonun, sud, soliq", "Yer, suv, xalq"], "a": 1, "e": "Temur o‘ylari." },
    { "t": 10, "q": "Abdulla Oripov kimning «Ilohiy komediya»sini tarjima qilgan?", "o": ["Gyotening", "Dantening", "Shekspirning", "Pushkinning"], "a": 1, "e": "Shevchenko, Nekrasov, R. Hamzatovni ham tarjima qilgan." },
    { "t": 11, "q": "«Eng so‘nggi xazina» she’ri kimga bag‘ishlangan?", "o": ["Abdulla Oripovga", "Xudoyberdi Doniyorovga", "Navoiyga", "Onasiga"], "a": 1, "e": "Mustabid tuzum davrida yozilgan jasoratli she’r." },
    { "t": 12, "q": "Halima Xudoyberdiyeva qaysi to‘plami uchun Davlat mukofoti olgan?", "o": ["«Ilk muhabbat»", "«Muqaddas ayol»", "«Oq olmalar»", "«Chaman»"], "a": 1, "e": "1990-yilda." },
    { "t": 12, "q": "«Begim, sizni tabiat...» she’ridagi ayol kelin tushgan kecha nima qiladi?", "o": ["Uydan ketadi", "Hovliga mix qoqib, o‘zini qiynab tunni o‘tkazadi", "Qo‘shiq aytadi", "Yig‘lab uxlaydi"], "a": 1, "e": "Ayol sadoqati va iztirobi." },
    { "t": 13, "q": "«Turkiylar» she’ri qanday satr bilan yakunlanadi?", "o": ["«Vatan — ona!»", "«Yovga ters qaragan musulmon emas!»", "«Shuni uyg‘ot hali imkon borida!»", "«Biz hali hammadan o‘tamiz!»"], "a": 1, "e": "Shavkat Rahmon she’ri." },
    { "t": 13, "q": "Shavkat Rahmon qayerda tug‘ilgan?", "o": ["Toshkentda", "O‘sh shahrida", "Andijonda", "Namanganda"], "a": 1, "e": "1950-yil 12-sentabrda." },
    { "t": 14, "q": "Qo‘chqor uyidagi kemtikliklar nimaning timsoli?", "o": ["Boylikning", "G‘arib turmushga ko‘nikkan odamning", "Ilmning", "Mehnatsevarlikning"], "a": 1, "e": "Derazaning ko‘zi, karavotning oyog‘i yo‘q." },
    { "t": 14, "q": "Sharof Boshbekov qaysi teatrda aktyor bo‘lgan?", "o": ["Hamza teatrida", "Muqimiy teatrida", "Yosh tomoshabinlar teatrida", "Ilhom teatrida"], "a": 1, "e": "So‘ng dramaturgiyaga o‘tgan." },
    { "t": 15, "q": "Shekspir qaysi teatrning hissadori bo‘lgan?", "o": ["«Globus»", "«Bolshoy»", "«Komedi Fransez»", "«La Skala»"], "a": 0, "e": "1598-yildan." },
    { "t": 15, "q": "Hamlet parda ortida kimni tasodifan o‘ldiradi?", "o": ["Klavdiyni", "Poloniyni", "Laertni", "Horatsioni"], "a": 1, "e": "Shundan so‘ng Ofeliya aqldan ozadi." },
    { "t": 16, "q": "Edigey Kazangapni qayerga dafn etish uchun yo‘lga chiqadi?", "o": ["Sario‘zakka", "Ona Bayitga", "Talasga", "Olmaotaga"], "a": 1, "e": "Ajdodlar qabristoni — Ona Bayit." },
    { "t": 16, "q": "Romanda «zamonaviy manqurt» deb kim tasvirlanadi?", "o": ["Edigey", "Sobitjon", "Kazangap", "Jo‘lomon"], "a": 1, "e": "Ma’lumotli, ammo udumlarni mensimaydi." },
