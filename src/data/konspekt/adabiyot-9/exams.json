{
  "midterm": [
    { "t": 1, "q": "Tor ma’noda adabiyot deganda nima tushuniladi?", "o": ["Har qanday yozma asar", "Badiiy adabiyot", "Ilmiy adabiyot", "Ensiklopediyalar"], "a": 1, "e": "Keng ma’noda — qimmatga ega har qanday yozma asar." },
    { "t": 1, "q": "Badiiy asarda nimalar qorishib keladi?", "o": ["Raqam va jadval", "Fikr bilan tuyg‘u", "Faqat voqealar", "Faqat dalillar"], "a": 1, "e": "Ijodkor betaraf bo‘lolmaydi." },
    { "t": 2, "q": "«Alpomish» dostonining ming yilligi qachon nishonlangan?", "o": ["1991-yilda", "1999-yilda", "2000-yilda", "1996-yilda"], "a": 1, "e": "Doston yaratilganining ming yilligi." },
    { "t": 2, "q": "Hakimbek bilan Barchinni kim beshikkerti qiladi?", "o": ["Boysari", "Shohimardon pir", "Alpinbiy", "Toychixon"], "a": 1, "e": "Ular beshikdayoq unashtiriladi." },
    { "t": 2, "q": "Qorajon qanday obraz?", "o": ["Fitnachi kampir", "Iymon keltirib, do‘stlikka sadoqat ko‘rsatgan qalmoq polvoni", "Arazchi ota", "Qalmoq shohi"], "a": 1, "e": "Poygada Boychiborni minib g‘olib bo‘ladi." },
    { "t": 2, "q": "Doston she’rlarida jang tasvirida necha bo‘g‘inli misralar qo‘llanadi?", "o": ["11", "7–8", "14", "5"], "a": 1, "e": "Tinch holatda — 11 bo‘g‘inli." },
    { "t": 3, "q": "Nizomiy Ganjaviy «Xamsa»si qanday ataladi?", "o": ["«Haft avrang»", "«Panj ganj»", "«Hasht behisht»", "«Haft paykar»"], "a": 1, "e": "1173–1201-yillarda yozilgan." },
    { "t": 3, "q": "«Firoq-u rashk-u hajr-u oh ila dard» misrasida qaysi san’at bor?", "o": ["Takrir", "Kitobat", "Tashbih", "Iyhom"], "a": 1, "e": "Bosh harflardan Farhod ismi hosil bo‘ladi." },
    { "t": 3, "q": "Irfoniy talqinda Shirin nimaning timsoli?", "o": ["Nafsning", "Iymon ko‘zgusining", "Hokimiyatning", "Boylikning"], "a": 1, "e": "Farhod — solik, Xusrav — nafs lashkari." },
    { "t": 3, "q": "«Hayrat ul-abror» necha maqolatdan iborat?", "o": ["10", "20", "40", "5"], "a": 1, "e": "Falsafiy-ta’limiy doston." },
    { "t": 4, "q": "Iskandar Doroning xoin qullariga nima beradi?", "o": ["Oltin", "Dor", "Vazirlik", "Ozodlik"], "a": 1, "e": "Va’dasidagi «yuqori o‘rin» — dor." },
    { "t": 4, "q": "Musofir haqidagi hikoyatning ramziy ma’nosi nima?", "o": ["Savdo foydasi", "Dunyo o‘tkinchi — oxirat uchun oldindan ezgu amal to‘plash kerak", "Dengiz xavfi", "Podshohlik sirlari"], "a": 1, "e": "Orol — oxirat ramzi." },
    { "t": 5, "q": "Ogahiy qaysi lavozimda ishlagan?", "o": ["Vazir", "Mirob", "Qozi", "Shayxulislom"], "a": 1, "e": "1829-yilda Munis o‘rniga mirob etib tayinlangan." },
    { "t": 5, "q": "Ogahiy devonidagi forsiy misralar qancha?", "o": ["Devonning yarmi", "1300 misradan ortig‘i", "Hammasi forsiy", "Forsiy misra yo‘q"], "a": 1, "e": "Salkam 20 ming misradan 1300 dan ortig‘i forsiy." },
    { "t": 6, "q": "Furqat qaysi gazetada tarjimon bo‘lib ishlagan?", "o": ["«Taraqqiy»", "«Turkiston viloyatining gazeti»", "«Sadoi Turkiston»", "«Oyina»"], "a": 1, "e": "1890–1891-yillarda, Toshkentda." },
    { "t": 6, "q": "Hodisaga chiroyli, shoirona sabab topish qaysi san’at?", "o": ["Tashxis", "Husni ta’lil", "Ishtiqoq", "Tajnis"], "a": 1, "e": "Gulning qizilligi — uyalganidan." },
    { "t": 7, "q": "Imom al-Buxoriy qancha hadisni yod bilgan?", "o": ["7275 ta", "600 mingga yaqin", "4000 ta", "100 ming"], "a": 1, "e": "«Sahih»ga 7275 hadis kiritgan." },
    { "t": 7, "q": "Imom al-Buxoriyning shogirdi kim?", "o": ["Abu Iso at-Termiziy", "Hakim at-Termiziy", "Abu Mansur al-Moturidiy", "Ibn Sino"], "a": 0, "e": "Shogirdi va safdoshi." },
    { "t": 8, "q": "«Navoiy» romanidagi parchada kim isyon ko‘taradi?", "o": ["Husayn Boyqaro", "Mirzo Yodgor", "Binoiy", "Shahobiddin"], "a": 1, "e": "Xuroson taxti uchun." },
    { "t": 8, "q": "Romanda ilm nimaga o‘xshatiladi?", "o": ["Ko‘milgan xazinaga", "Jonli daraxtga", "Daryoga", "Chiroqqa"], "a": 1, "e": "«O‘smog‘i, gullamog‘i, meva bermog‘i kerak!»" }
