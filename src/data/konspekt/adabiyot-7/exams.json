    { "t": 22, "q": "Zavqiy qaysi shaharda tug‘ilgan?", "o": ["Qo‘qonda", "Toshkentda", "Xivada", "Marg‘ilonda"], "a": 0, "e": "Qo‘qonning Shayxon mahallasida, mahsido‘z oilasida." },
