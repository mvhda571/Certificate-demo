    { "t": 20, "q": "Uvaysiy qaysi shaharda tug‘ilgan?", "o": ["Qo‘qonda", "Marg‘ilonda", "Andijonda", "Xo‘jandda"], "a": 1, "e": "Jahon Otin Uvaysiy (1779–1845)." },
