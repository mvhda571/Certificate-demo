    { "t": 24, "q": "O‘zbek romanchiligi asoschisi kim?", "o": ["Cho‘lpon", "Abdulla Qodiriy", "Abdulla Qahhor", "Oybek"], "a": 1, "e": "Ilk o‘zbek romani — «O‘tkan kunlar»." },
