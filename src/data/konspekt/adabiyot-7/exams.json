    { "t": 9, "q": "Hijolarning sifatiga (qisqa, cho‘ziq) asoslangan vazn qaysi?", "o": ["Barmoq", "Aruz", "Erkin vazn", "Sillabik"], "a": 1, "e": "Barmoq bo‘g‘inlar soniga asoslanadi." },
