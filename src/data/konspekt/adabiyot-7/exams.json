    { "t": 12, "q": "Sarsonboy otaning do‘sti choyxonachi kim?", "o": ["Madumar aka", "Haydarali", "Qobil bobo", "Mo‘min chol"], "a": 0, "e": "U qo‘ylarni kolxozga topshirishni maslahat beradi." },
    { "t": 13, "q": "«Oq kema»da bola oxirida nima qiladi?", "o": ["Shaharga qochadi", "Baliqqa aylanib oq kemaga suzish uchun daryoga tushadi", "O‘rozqul bilan yarashadi", "Maktabga ketadi"], "a": 1, "e": "Bola yovuzlik bilan murosa qilmaydi." },
