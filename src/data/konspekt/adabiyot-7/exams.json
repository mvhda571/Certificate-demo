    { "t": 2, "q": "Hamza qaysi harakat yo‘liga kirgan?", "o": ["Tasavvuf", "Jadidchilik", "Xalq og‘zaki ijodi", "Sho‘rochilik"], "a": 1, "e": "1907-yildagi Qashqar safaridan so‘ng." },
    { "t": 2, "q": "«Dardiga darmon istamas»da qaysi illat qoloqlik sababi sifatida ko‘rsatilmagan?", "o": ["Johillik", "Ta’magirlik", "Befarqlik", "Ilmga haddan ziyod berilish"], "a": 3, "e": "Aksincha, ilm-irfonga intilmaslik sabab qilib ko‘rsatiladi." },
    { "t": 3, "q": "Adabiyotning tarbiyaviy vazifalaridan biri qaysi?", "o": ["Sezimlarni noziklashtirish", "Raqamlarni yodlatish", "Qonun chiqarish", "Savdo o‘rgatish"], "a": 0, "e": "Adabiyot so‘zdan ta’sirlanish tuyg‘usini tarbiyalaydi." },
    { "t": 4, "q": "Saida Zunnunova qayerda tug‘ilgan?", "o": ["Toshkentda", "Andijonda", "Farg‘onada", "Namanganda"], "a": 1, "e": "1926-yil 15-fevralda Andijonda tug‘ilgan." },
    { "t": 4, "q": "«Jahon mening bag‘rimdami yo men jahon bag‘rida?» satri qaysi she’rdan?", "o": ["«Mening Vatanim»", "«Qizimga»", "«Yer uzra qo‘ndi oqshom»", "«Salom senga»"], "a": 1, "e": "Farzand baxtidan masrur ona tuyg‘ulari." },
    { "t": 5, "q": "«Mardlik afsonasi»da massagetlar shiori qaysi?", "o": ["«Qo‘li bog‘liq yashashdan o‘lim a’lodir»", "«Bir yoqadan bosh chiqar»", "«Yov qochsa, botir ko‘payar»", "«Vatan — ona»"], "a": 0, "e": "Massagetlar bosqinchiga qarshi jangga otlanadi." },
    { "t": 5, "q": "Shuhratning asl ismi nima?", "o": ["G‘ulom Aminjon o‘g‘li Alimov", "Yunus Latif", "Muso Toshmuhammad o‘g‘li", "Asqad Muxtorov"], "a": 0, "e": "Yunus Latif — uning adabiyot o‘qituvchisi." },
    { "t": 6, "q": "Balladaga xos xususiyat qaysi?", "o": ["Juda katta hajm", "Shoir tuyg‘ulari bilan birga ularga sabab bo‘lgan voqealar tasviri", "Faqat hajviy ruh", "Nasriy shakl"], "a": 1, "e": "Ballada — lirik va epik xususiyat uyg‘un janr." },
    { "t": 7, "q": "Rasul Hamzatovning otasi kim?", "o": ["Hamzat Sadasa", "Abay", "Mirtemir", "Hamza"], "a": 0, "e": "Mashhur avar shoiri." },
    { "t": 7, "q": "«Ona tilim» she’rida qahramon qayerda o‘lib yotgan bo‘ladi?", "o": ["Jang maydonida", "Tushida tog‘lar orasida", "Dengiz qirg‘og‘ida", "Shaharda"], "a": 1, "e": "Avar tilidagi so‘zlar uni tiriltiradi." },
