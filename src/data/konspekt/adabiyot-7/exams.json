    { "t": 17, "q": "Navoiyning tazkira asari qaysi?", "o": ["«Mezon ul-avzon»", "«Majolis un-nafois»", "«Lison ut-tayr»", "«Munshaot»"], "a": 1, "e": "«Mezon ul-avzon» — aruz haqida." },
    { "t": 18, "q": "«Sab’ai sayyor»dagi hikoya qaysi iqlim musofiri tomonidan aytilgan?", "o": ["Birinchi", "Uchinchi", "Beshinchi", "Yettinchi"], "a": 2, "e": "Mehr va Suhayl qissasi." },
    { "t": 18, "q": "«Suhayl» ismi nimani anglatadi?", "o": ["Quyosh", "Yorqin yulduz (Kanopus)", "Dengiz", "Zolim"], "a": 1, "e": "Suhayl — mard, jasur, sodiq oshiq." },
