    { "t": 2, "q": "«Unuqqan» deb aytiladigan so‘z qanday yoziladi?", "o": ["Unuqqan", "Uniqqan", "Unqqan", "Unuqan"], "a": 1, "e": "Imlo lug‘ati." },
    { "t": 3, "q": "«Masxaraboz» qanday talaffuz qilinadi?", "o": ["Masxaraboz", "Masxaravoz", "Masxarapoz", "Mashxaraboz"], "a": 1, "e": "Yoziladi — masxaraboz." },
