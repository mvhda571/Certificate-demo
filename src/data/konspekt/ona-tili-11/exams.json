    { "t": 5, "q": "«Osma ko‘prik» qanday yoziladi?", "o": ["Qo‘shib", "Ajratib", "Chiziqcha bilan", "Ikki xil"], "a": 1, "e": "Har qismida urg‘u." },
    { "t": 5, "q": "Qo‘shma so‘zlar nimadan hosil bo‘ladi?", "o": ["Qo‘shimchalardan", "So‘z birikmasidan", "Iboralardan", "Gaplardan"], "a": 1, "e": "Aylanganlari qo‘shib yoziladi." },
    { "t": 5, "q": "«Katta-kichik» juft so‘zining ikkinchi yozilishi?", "o": ["Kattakichik", "Katta-yu kichik", "Katta kichik", "Katta va kichik"], "a": 1, "e": "Juft so‘zlar ikki xil." },
    { "t": 6, "q": "So‘z bilan ishlash bosqichlari?", "o": ["O‘qish, yozish", "Anglash, farqlash, tanlash, qo‘llash", "Yodlash, aytish", "Tarjima, tahrir"], "a": 1, "e": "Bilim va farosat." },
    { "t": 7, "q": "«Tug‘moq» o‘rniga «farzandli bo‘lmoq» deyish qaysi asosdagi taqiq?", "o": ["Qo‘rquv", "Uyat", "Hurmat", "Kinoya"], "a": 1, "e": "Odob." },
    { "t": 7, "q": "«Tabu» so‘zi qaysi tildan olingan?", "o": ["Grek", "Polineziya", "Lotin", "Arab"], "a": 1, "e": "Nutqiy taqiq." },
    { "t": 8, "q": "Disfemizm so‘zining ma’nosi?", "o": ["Yumshoq gapirmoq", "Qo‘pol gapirmoq", "Tez gapirmoq", "Sekin gapirmoq"], "a": 1, "e": "Evfemizmning aksi." },
    { "t": 8, "q": "Evfemizmni o‘rinli qo‘llash nimaning belgisi?", "o": ["Qo‘rqoqlik", "Madaniyatlilik", "Ilmiylik", "Rasmiyatchilik"], "a": 1, "e": "Disfemizm ko‘pligi — madaniyatsizlik." },
    { "t": 8, "q": "«Yomon bo‘libdi» ning evfemizmi?", "o": ["Rasvo bo‘libdi", "Yaxshi bo‘lmabdi", "Juda yomon", "Buzilibdi"], "a": 1, "e": "Yumshoq ifoda." },
