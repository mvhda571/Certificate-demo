    { "t": 14, "q": "«Gapingizga tushunmadim» ning sinonimi?", "o": ["Gapingizdan tushunmadim", "Gapingizni tushunmadim", "Gapingizda tushunmadim", "Gapingiz tushunmadim"], "a": 1, "e": "Kelishik sinonimiyasi." },
