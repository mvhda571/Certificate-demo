  "midterm": [
    { "t": 1, "q": "«Bog‘ga» so‘zi qanday talaffuz qilinadi?", "o": ["Bog‘ga", "Boqqa", "Bokka", "Bog‘a"], "a": 1, "e": "Yozuvda aks etmaydi." },
