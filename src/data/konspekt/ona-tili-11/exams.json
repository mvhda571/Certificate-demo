    { "t": 1, "q": "«Iqtisod» so‘zi qanday talaffuz qilinadi?", "o": ["Iqtisod", "Ixtisod", "Iktisod", "Iqtisot"], "a": 1, "e": "O‘zlashma so‘z." },
    { "t": 2, "q": "«Partret» deb aytiladigan so‘z qanday yoziladi?", "o": ["Partret", "Portret", "Portret’", "Partreit"], "a": 1, "e": "Unli imlosi." },
    { "t": 2, "q": "«Kompyuter» so‘zini yozilganidek talaffuz qilish?", "o": ["Me’yor", "Og‘zaki me’yordan chetga chiqish", "Majburiy", "Faqat rasmiy nutqda kerak"], "a": 1, "e": "Kampyuter deb aytiladi." },
    { "t": 3, "q": "«Pedagog» so‘zi qanday talaffuz qilinadi?", "o": ["Pedagog", "Pedagok", "Pedagox", "Pedagoq"], "a": 1, "e": "Undosh o‘zgarishi." },
    { "t": 3, "q": "Undoshlar imlosi nima bilan me’yorlashtirilgan?", "o": ["Shevalar bilan", "Qoidalar va lug‘atlar bilan", "Talaffuz bilan", "Me’yorlashmagan"], "a": 1, "e": "Imlo qat’iy." },
