    { "t": 9, "q": "«Siz» olmoshi nimani ifodalaydi?", "o": ["Kamtarlik", "Hurmat", "Kinoya", "Ko‘plik faqat"], "a": 1, "e": "Bosh harf bilan — alohida hurmat." },
    { "t": 9, "q": "Badiiy matnda kishilik olmoshlarining ortiqcha qo‘llanishi?", "o": ["Matnni boyitadi", "Matn saviyasini tushiradi", "Majburiy", "Ta’siri yo‘q"], "a": 1, "e": "Olmoshlar uslubiyati." },
