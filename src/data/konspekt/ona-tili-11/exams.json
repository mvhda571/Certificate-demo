    { "t": 5, "q": "«Olib kelmoq» qanday yoziladi?", "o": ["Qo‘shib", "Ajratib", "Chiziqcha bilan", "Qisqartirib"], "a": 1, "e": "Ko‘makchi fe’lli birikma." },
