    { "t": 10, "q": "Iboralarni ko‘p qo‘llash nimaning belgisi?", "o": ["Savodsizlik", "Til bilimi va nutqiy salohiyat", "Rasmiyatchilik", "Shevaga moyillik"], "a": 1, "e": "Bo‘yoqdor nutq." },
