  "7": [
    ["Misrning janubiy qo‘shnisi", "Nubiya."],
    ["Nubiyadan nimalar keltirilgan?", "Oltin va fil suyagi."],
    ["Misrning g‘arbiy qo‘shnisi", "Liviya — ko‘chmanchi chorvadorlar yurti."],
    ["Misrning shimoli-sharqidagi qo‘shnilari", "Falastin va Suriya."],
    ["Misr qo‘shnilariga nisbatan qanday yo‘l tutgan?", "Ularning ko‘pini bosib olgan."],
    ["Giksoslar kim?", "Quyi Misrni bosib olgan ko‘chmanchilar."],
