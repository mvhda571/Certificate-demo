    ["Nil daryosining uzunligi", "6 ming km."],
    ["Nil vodiysining kengligi", "3 km dan 22 km gacha."],
    ["Nil qaysi dengizga quyiladi?", "O‘rtayer dengiziga."],
    ["Delta", "Daryoning dengizga quyiladigan shoxobchali qismi."],
    ["Nega quyilish joyi «delta» deb atalgan?", "U yunoncha Δ (delta) harfi kabi uchburchak shaklida."],
    ["Nil toshqinining foydasi", "Dalalarga unumdor loyqa qoldirgan — dehqonchilik rivojlangan."],
    ["Odamlar Nil qirg‘oqlarini qachon o‘zlashtirdi?", "Mil. avv. 4-ming yillik boshlarida."],
