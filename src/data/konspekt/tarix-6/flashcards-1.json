    ["Gilgamish", "Uruk podshosi, abadiy hayot sirini izlagan afsona qahramoni."],
    ["Shumer va Akkadni kim birlashtirgan?", "Akkad shohi Sargon I."],
    ["Sargon I qachon hukmronlik qilgan?", "Mil. avv. 3-ming yillikning ikkinchi yarmida."],
    ["Sargon I qo‘shini", "5400 kishilik doimiy qo‘shin."],
    ["Sargon davlati qanday parchalandi?", "Mil. avv. 2-ming yillik boshida ko‘chmanchilar zarbasidan."],
    ["Mesopotamiyada «Hayot daraxti»", "Xurmo daraxti."],
    ["Tuzoq savol: Shumer shimoldami yoki janubda?", "Janubda! Shimoliy qism — Akkad."]
  ],
  "12": [
    ["Bobil so‘zining ma’nosi", "«Xudolar darvozasi»."],
    ["Bobil qachon eng qudratli davlatga aylandi?", "Mil. avv. 2-ming yillikda."],
    ["Mesopotamiyani birlashtirgan Bobil podshosi", "Xammurapi."],
