{
  "1": [
    ["Tarixni qanday manbalar orqali bilamiz?", "Moddiy (yerdan topilgan buyumlar) va yozma (kitoblar, bitiklar) manbalar orqali."],
    ["Moddiy (ashyoviy) manba", "Yerdan topilgan buyumlar: mehnat qurollari, taqinchoqlar, qurol-aslahalar, sopol idishlar."],
    ["Yozma manba", "Yozib qoldirilgan matnlar: qadimgi kitoblar va bitiklar."],
    ["O‘rta Osiyo tarixi bo‘yicha eng qadimgi yozma manba", "«Avesto» — zardushtiylarning muqaddas kitobi."],
    ["«Avesto»da qaysi qadimgi viloyatlarimiz tilga olinadi?", "Baqtriya, So‘g‘d va Xorazm."],
    ["Qadimgi tarix qachondan boshlanadi?", "Odamning paydo bo‘lishidan."],
    ["Gerodot kim?", "Mil. avv. V asrda yashagan yunon tarixchisi, to‘qqiz kitobli «Tarix» asari muallifi."],
    ["«Tarix otasi» deb kimni atashadi?", "Gerodotni."],
    ["Strabon qaysi asarida O‘rta Osiyo xalqlari haqida yozgan?", "«Geografiya» asarida (mil. avv. I asr oxiri)."],
    ["Kvint Kursiy Ruf kim?", "Milodiy I asrda yashagan rimlik tarixchi, «Makedoniyalik Aleksandr tarixi» muallifi."],
    ["«Aleksandr anabasisi» asari muallifi", "Arrian — milodiy II asrda yashagan yunon muallifi."],
    ["«Aleksandr anabasisi» nima haqida?", "Aleksandrning harbiy yurishlari haqida."],
    ["Arxeolog", "Qazish ishlari olib borib, yerdan qadimgi buyumlarni topadigan olim."],
    ["Antropolog", "Odam suyaklari va tashqi ko‘rinishini o‘rganadigan olim."],
    ["Etnograf", "Xalqlarning urf-odatlarini o‘rganadigan olim."],
    ["Tosh davri necha bosqichga bo‘linadi?", "4 bosqichga: paleolit, mezolit, neolit, eneolit."],
    ["«Litos» so‘zining ma’nosi", "Yunoncha «tosh» degani."],
    ["Paleolit, mezolit, neolit, eneolit — ma’nolari", "Qadimgi tosh, o‘rta tosh, yangi tosh va mis-tosh davri."],
    ["Ibtidoiy jamoa tuzumi", "Hamma birga mehnat qilgan, mehnat qurollari umumiy bo‘lgan davr."],
    ["Matriarxat va patriarxat", "Avval ayol, keyin erkak jamoada yetakchi bo‘lgan davrlar."]
  ],
  "2": [
    ["Ibtidoiy odamlar", "Eng qadimgi odamlar; ularning makonlari Afrika, Osiyo va Yevropadan topilgan."],
    ["Paleolit necha qismga bo‘linadi?", "Uch qismga: ilk, o‘rta va so‘nggi paleolit."],
    ["Ilk paleolit davri", "Mil. avv. taxminan 100 ming yilgacha bo‘lgan davr."],
    ["Ilk paleolit odamlari", "Avstralopitek, zinjantrop, pitekantrop va sinantrop."],
    ["O‘rta paleolit yillari", "Mil. avv. 100–40 ming yillar."],
    ["O‘rta paleolit odam turi", "Neandertal."],
    ["So‘nggi paleolit yillari", "Mil. avv. 40–12 ming yillar."],
    ["So‘nggi paleolit odam turi", "Kromanyon — hozirgi odamga eng yaqin tur."],
    ["Selungur makoni qayerda?", "Farg‘ona vodiysida; u yerdan juda qadimgi tosh qurollar topilgan."],
    ["Ko‘lbuloq manzilgohi qayerda?", "Toshkent vohasida."],
    ["Teshiktosh g‘ori qayerda joylashgan?", "Surxondaryoda."],
    ["Teshiktoshdan nima topilgan?", "8–9 yashar neandertal bolaning suyak qoldiqlari."],
    ["Altamira g‘ori", "Ispaniyadagi eng qadimgi g‘or rasmlari topilgan g‘or."],
    ["Lasko g‘ori", "Fransiyadagi qadimgi g‘or rasmlari topilgan g‘or."],
    ["Kapova g‘ori", "Boshqirdistondagi qadimgi g‘or rasmlari bor g‘or."],
    ["Ilk diniy e’tiqodlar nega paydo bo‘lgan?", "Odamlar tabiat hodisalarini (kun-tun, vulqon, zilzila) tushunolmay, ularga sig‘ina boshlagan."],
    ["Totemizm", "Biror hayvon yoki o‘simlikni urug‘ning ajdodi deb bilish."],
    ["Animizm", "Hamma narsada ruh bor, deb ishonish."],
    ["Fetishizm", "Tumor, tosh kabi buyumlarda sehrli kuch bor, deb ishonish."],
    ["O‘zbekistonda qadimgi odamlar yashaganini nima isbotlaydi?", "Teshiktosh va Selungur topilmalari."]
  ],
  "3": [
    ["So‘nggi paleolit yillari", "Mil. avv. 40–12 ming yillar."],
    ["So‘nggi paleolitda qaysi odam yashagan?", "Kromanyon odami."],
    ["So‘nggi paleolitning eng muhim yutug‘i", "Sun’iy olov kashf qilindi."],
    ["Urug‘ jamoasi", "Yaqin qarindoshlardan iborat odamlar guruhi."],
    ["So‘nggi paleolitning O‘zbekistondagi makonlari", "Ko‘lbuloq (Toshkent viloyati), Samarqand makoni, Farg‘ona vodiysi."],
    ["Mezolit yillari", "Mil. avv. 12–7 ming yillar."],
    ["Mezolit so‘zining ma’nosi", "O‘rta tosh davri."],
    ["Mezolitdagi ikki muhim yangilik", "O‘q-yoy ixtiro qilindi va hayvonlar qo‘lga o‘rgatila boshlandi."],
    ["Mikrolit", "Mayda tosh qurol."],
    ["O‘zbekistondagi mezolit makonlari", "Obishir, Qo‘shilish, Machay, Zarautsoy."],
    ["Neolit O‘rta Osiyoda qachon bo‘lgan?", "Mil. avv. 6–4 ming yillarda."],
    ["Neolit so‘zining ma’nosi", "Yangi tosh davri."],
    ["Neolitda toshga qanday ishlov berildi?", "Toshni silliqlash va parmalashni o‘rgandilar."],
    ["Ishlab chiqaruvchi xo‘jalik", "Mahsulotni o‘zi yetishtirish: dehqonchilik va chorvachilik."],
    ["O‘troq turmush", "Bir joyda doimiy yashash."],
    ["Neolitda uylar nimadan qurilgan?", "Paxsadan."],
    ["Neolitda qaysi hunarlar paydo bo‘ldi?", "Kulolchilik va to‘quvchilik."],
    ["Dehqonchilik va chorvachilik dastlab qayerda paydo bo‘lgan?", "Old Osiyoda."],
    ["Insoniyat tarixidagi eng katta burilish", "Neolitda dehqonchilik, kulolchilik va o‘troq hayotning paydo bo‘lishi."],
    ["«Olov – O‘q – O‘troq» hiylasi", "Paleolit — olov, mezolit — o‘q-yoy, neolit — o‘troqlik."]
  ],
  "4": [
    ["Eneolit", "Mis-tosh davri."],
    ["Eneolit so‘zi qaysi so‘zlardan olingan?", "Lotincha «eneus» (mis) va yunoncha «litos» (tosh)."],
    ["Eneolit yillari", "Mil. avv. 4-ming yillik – 3-ming yillik o‘rtalari."],
    ["Nega eneolit «mis-tosh» davri deyiladi?", "Misdan qurollar yasalgan, lekin tosh qurollar ham ishlatilib turgan."],
    ["Eneolit davrining belgilari", "Naqshli sopol idishlar, sug‘orma dehqonchilik, ko‘p xonali uylar."],
    ["Sug‘orma dehqonchilik", "Ariq, kanal orqali sun’iy sug‘orishga asoslangan dehqonchilik."],
    ["Qadimgi Sharqda ilk shahar va davlatlar qachon paydo bo‘ldi?", "Mil. avv. 4-ming yillikda."],
    ["Bronza davri yillari", "Mil. avv. 3-ming yillik o‘rtalari – 2-ming yillik."],
    ["Bronza", "Mis va qalay qotishmasi."],
    ["Bronzaning misdan afzalligi", "U misdan ancha qattiq."],
    ["Bronzadan nimalar yasalgan?", "Mehnat qurollari, qurol-yarog‘ va zeb-ziynat."],
    ["Zamonbobo manzilgohi qayerda?", "Buxoro viloyatida."],
    ["Zamonbobodan nima topilgan?", "Bug‘doy va arpa donlari."],
    ["Zamonbobo qaysi davr yodgorligi?", "Bronza davri."],
    ["Bronza davrida chorvachilikda qanday o‘zgarish bo‘ldi?", "Chorvachilik dehqonchilikdan ajralib chiqa boshladi."],
    ["Patriarxat", "Erkakning jamoadagi ustunligi."],
    ["Nega patriarxat o‘rnatildi?", "Omoch bilan yer haydash va chorvachilik og‘ir mehnat bo‘lib, uni asosan erkaklar bajargan."],
    ["Patriarxal oila", "Ota boshchiligidagi, bir necha avlod yaqin qarindoshlardan iborat oila."],
    ["Metallarning o‘zlashtirilish tartibi", "Mis → Bronza → Temir."],
    ["«Mis — muloyim, Bronza — baquvvat, Temir — tosh-qattiq»", "Metallar qattiqligi bo‘yicha tartibini eslatuvchi hiyla."]
  ],
  "5": [
    ["Temir necha darajada eriydi?", "1500°C da."],
    ["Nega temir kechroq o‘zlashtirilgan?", "U misdan ancha yuqori haroratda eriydi — buni uddalash qiyin bo‘lgan."],
    ["Temirdan birinchi bo‘lib kim foydalangan?", "Kichik Osiyodagi xettlar."],
    ["Xettlar temirdan qachon foydalana boshlagan?", "Mil. avv. XIV–XIII asrlarda."],
    ["Xettlardan keyin temirni kimlar o‘zlashtirgan?", "Mesopotamiya, Eron va Kavkazorti xalqlari."],
    ["O‘rta Osiyodagi ilk temir qurollar davri", "Mil. avv. IX–VIII asrlar."],
    ["Temirdan qanday qurollar yasaldi?", "Temir omoch va boltalar."],
    ["Temir qurollar dehqonchilikka nima berdi?", "Katta maydonlarni haydash, o‘rmon va to‘qaylarni ochish mumkin bo‘ldi."],
    ["Hosil ko‘paygach jamiyatda nima o‘zgardi?", "Boylik to‘plandi, boy va kambag‘al paydo bo‘ldi."],
    ["Boylik ko‘payishi qanday oqibatga olib keldi?", "Qabilalar o‘rtasida urushlar ko‘paydi."],
    ["Qabilalar ittifoqi", "Bir necha qabilaning birlashmasi."],
    ["Qabilalar ittifoqini kim boshqargan?", "Saylab qo‘yilgan harbiy sardorlar."],
    ["Harbiy demokratiya", "Saylangan harbiy sardorlar boshchilik qilgan tartib."],
    ["Harbiy demokratiya qaysi bosqich hisoblanadi?", "Ilk davlatchilikka o‘tish davri."],
    ["«Xett — temirning otasi» hiylasi", "Temirni birinchi bo‘lib xettlar ishlatganini eslatadi."],
    ["«Avesto»ning ilk qismi qachon paydo bo‘lgan?", "Mil. avv. IX–VIII asrlarda — O‘rta Osiyodagi ilk temir qurollar bilan bir davrda."],
    ["Kichik Osiyo", "Hozirgi Turkiya hududi; xettlar shu yerda yashagan."],
    ["Temir davriga o‘tish nima uchun muhim?", "Mehnat unumdorligi oshdi, jamiyat davlatchilikka yaqinlashdi."],
    ["Harbiy sardor qanday tanlangan?", "Qabilalar ittifoqi tomonidan saylangan."],
    ["Nega qabilalar ittifoqqa birlashgan?", "Boylik ko‘payib, urushlar kuchaygani uchun birgalikda himoyalanish kerak bo‘lgan."]
  ],
  "6": [
