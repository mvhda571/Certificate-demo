    ["525-yildan keyin Misr qaysi davlat tarkibiga kirdi?", "Ahamoniylar davlati tarkibiga."],
    ["Kir II qachon va qanday halok bo‘lgan?", "Mil. avv. 530-yilda massagetlar bilan jangda."],
    ["«530 → 525» ketma-ketligi", "Kir II halok bo‘ldi (530), 5 yildan keyin o‘g‘li Kambiz Misrni oldi (525)."],
    ["Fir’avn", "Qadimgi Misr hukmdori."],
    ["Misr boshidan kechirgan ikki katta bosqin", "Giksoslar bosqini va forslar bosqini."],
    ["«525 — Kambiz Keldi» hiylasi", "Misrning forslar tomonidan bosib olingan yilini eslatadi."]
  ],
  "8": [
    ["Misrliklar nechta xudoga sig‘ingan?", "Ko‘p xudoga."],
    ["Misrliklar xudolarni qanday tasavvur qilgan?", "Ko‘pincha hayvon qiyofasida."],
