  "9": [
    ["Piramida", "Fir’avnning maqbarasi."],
    ["Nega misrliklar jasadni mumiyolagan?", "O‘limdan keyingi hayotga ishongan, buning uchun jasad saqlanishi kerak edi."],
    ["Mumiyolash necha kun davom etgan?", "70 kun."],
    ["Giza vodiysidagi uchta mashhur piramida", "Xufu, Xafra va Menkaura piramidalari."],
    ["Eng katta piramida", "Xufu (Xeops) piramidasi."],
    ["Xeops", "Xufu ismining yunoncha shakli."],
    ["Xufu piramidasi qachon qurilgan?", "Mil. avv. 2600-yil atrofida."],
    ["Xufu piramidasining balandligi", "147 metr."],
    ["Sfinks", "Odam boshli, sher tanali ulkan haykal."],
    ["Sfinks nomining ma’nosi", "«Sahro shohi»."],
    ["«Hamma narsa vaqtdan qo‘rqadi, vaqt esa piramidalardan»", "Piramidalar 4 ming yildan beri deyarli o‘zgarmay turgani haqidagi ibora."],
    ["Daxma", "Tog‘larga o‘yilgan tosh maqbara."],
    ["Keyinroq fir’avnlar qayerga dafn etilgan?", "Tog‘larga o‘yilgan tosh maqbaralarga — daxmalarga."],
    ["Eng mashhur saqlanib qolgan maqbara", "Yosh fir’avn Tutanxamon maqbarasi."],
    ["Tutanxamon maqbarasining alohida jihati", "U talon-taroj qilinmay saqlangan."],
    ["Osiris sudi", "Rivoyatga ko‘ra, marhumning yuragi tarozining bir pallasiga, qush pati ikkinchisiga qo‘yilgan."],
    ["«Xo‘p, Xafa, Mehmon» hiylasi", "Piramidalar tartibi: Xufu – Xafra – Menkaura."],
    ["Mashhur piramidalar qayerda joylashgan?", "Giza vodiysida."],
    ["Mumiya", "Uzoq saqlanishi uchun maxsus ishlov berilgan jasad."],
    ["Piramidalar qanday inshoot?", "Fir’avnlar uchun qurilgan ulkan tosh maqbaralar."]
  ],
  "10": [
    ["Misr yozuvi belgilari", "Iyerogliflar."],
    ["Iyerogliflar soni", "750 ta."],
    ["Misrliklar iyerogliflarni nima deb atagan?", "«Xudolar kalomi», «ilohiy bitiklar»."],
    ["Misrliklar nimalarga yozgan?", "Papirusga, toshga va devorga."],
    ["Rozett toshi", "Bir xil matn ikki tilda yozilgan, Misr yozuvini o‘qishga kalit bo‘lgan tosh."],
    ["Rozett toshidagi tillar", "Qadimgi misr va qadimgi yunon tillari."],
    ["Misr yozuvini birinchi bo‘lib kim o‘qigan?", "Fransuz olimi Jan-Fransua Shampolyon."],
    ["Shampolyon Misr yozuvini qachon o‘qigan?", "1822-yilda."],
    ["Misrliklar yilni necha kun deb aniqlagan?", "365 kun."],
    ["Birinchi bo‘lib taqvim tuzgan xalq", "Misrliklar."],
    ["Misr taqvimining tuzilishi", "12 oy × 30 kun = 360 kun va yana 5 ta bayram kuni."],
    ["Misrliklar yil uzunligini qanday aniqlagan?", "Yulduzlarni kuzatib."],
    ["Nega Misrda geometriya rivojlangan?", "Nil toshqinidan keyin dalalarni qayta o‘lchash kerak bo‘lgan."],
    ["Misrliklar matematikadan yana nimani bilgan?", "Kasrlarni."],
    ["«Astronomiya → taqvim → geometriya»", "Misr fanining rivojlanish zanjiri."],
    ["Misr yozuvining tarixdagi o‘rni", "Insoniyatning ilk yozuvlaridan biri."],
    ["Nega Misr yozuvini uzoq vaqt o‘qiy olishmagan?", "Rozett toshi topilmaguncha iyerogliflarning kaliti yo‘q edi."],
    ["«Shampolyon — Sham yoqdi» hiylasi", "U qorong‘i yozuvni «yoritdi», ya’ni birinchi bo‘lib o‘qidi."],
    ["Astronomiya", "Osmon jismlari va yulduzlarni kuzatib o‘rganuvchi fan."],
    ["Misr taqvimidagi 5 qo‘shimcha kun", "Bayram kunlari bo‘lgan."]
  ],
  "11": [
    ["Mesopotamiya so‘zining ma’nosi", "«Ikki daryo oralig‘i»."],
    ["Mesopotamiya daryolari", "Dajla va Frot."],
    ["Daryolar toshqinining foydasi", "Dalalarga unumdor loyqa olib kelgan."],
