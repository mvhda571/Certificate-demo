{
  "23": [
    ["Koloniya", "Yunonlar boshqa yerlarda tashkil etgan yangi shahar-manzilgoh."],
    ["Yunon koloniyalari qachon tashkil topgan?", "Mil. avv. VIII–VI asrlarda."],
    ["Koloniyalar qaysi dengizlar sohilida?", "O‘rtayer va Qora dengiz sohillarida."],
    ["Nega yunonlar boshqa yerlarga ko‘chgan?", "Yer kam, aholi esa ko‘paygan edi."],
    ["Kambag‘allar nimadan qochgan?", "Zodagonlarning zulmidan."],
    ["Savdogarlar nima izlagan?", "Yangi bozorlar."],
    ["Qora dengizdagi mashhur koloniyalar", "Olviya, Xersones, Pantikapey."],
    ["Italiyadagi yunon koloniyalari qayerda?", "Italiya janubi va Sitsiliyada."],
    ["Koloniyalar keyinchalik nimaga aylangan?", "Mustaqil shahar-davlatlarga."],
    ["Koloniyada nimalar bo‘lgan?", "O‘z hokimi, qo‘shini, qonuni va tangasi."],
    ["Koloniya ona shahar bilan qanday aloqa saqlagan?", "Savdo va madaniy aloqa."],
    ["Yunon alifbosi nimaga asoslangan?", "Finikiya alifbosiga."],
    ["Yunon alifbosi qachon paydo bo‘lgan?", "Mil. avv. VIII asrda."],
    ["Yunon alifbosida nechta harf bor?", "24 ta."],
    ["Finikiya alifbosida nechta harf bor?", "22 ta."],
    ["«O‘X-P» hiylasi", "Olviya, Xersones, Pantikapey — Qora dengizdagi koloniyalar."],
    ["Ona shahar", "Koloniyani tashkil qilgan yunon shahri."],
    ["Sitsiliya", "Yunon koloniyalari ko‘p bo‘lgan orol."],
    ["Koloniyalarning yunonlar uchun foydasi", "Yangi yerlar va savdo bozorlari."],
    ["Zodagonlar", "Boy va imtiyozli oilalar vakillari."]
  ],
  "24": [
    ["Demokratiya", "Xalq hokimiyati."],
    ["Aristokratiya", "Zodagonlar hokimiyati."],
    ["Demos", "Oddiy xalq."],
    ["Afina xalqi nimani talab qilgan?", "Yozma qonunlarni."],
    ["Drakont qonunlari qachon qabul qilingan?", "Mil. avv. 621-yilda."],
    ["Drakont qonunlarining xususiyati", "Juda qattiq: arzimas qonunbuzarlik uchun ham o‘lim jazosi."],
    ["«Siyoh bilan emas, qon bilan yozilgan»", "Drakont qonunlari haqidagi ibora."],
    ["Solon islohotlari qachon?", "Mil. avv. 594-yilda."],
    ["Solon nima qildi?", "Aristokratiya boshqaruvini demokratiyaga almashtirdi."],
    ["Solon nimani bekor qildi?", "Qarzga qullikni."],
    ["Xalq majlisida kim qatnashgan?", "20 yoshdan oshgan barcha erkak fuqarolar."],
    ["Agora", "Xalq yig‘ilishi o‘tadigan maydon."],
    ["Beshyuzlar kengashi", "Har yili saylanib, kundalik ishlarni hal qilgan kengash."],
    ["Demokratiyada kimlar qatnashmagan?", "Ayollar, meteklar va qullar."],
    ["Perikl asri", "Mil. avv. 443–429-yillar."],
    ["Perikl necha marta strateg bo‘lgan?", "15 marta."],
    ["Strateg", "Saylanadigan harbiy boshliq."],
    ["Perikl davrida Afina", "Eng qudratli bo‘ldi, demokratiya gullab-yashnadi."],
    ["«D-S-P» tartibi", "Drakont → Solon → Perikl."],
    ["«Drakon qonunlari» iborasi bugun nimani bildiradi?", "Juda qattiq qonunlarni."]
  ],
  "25": [
    ["Yunon-fors urushlari qachon boshlangan?", "Mil. avv. V asr boshida."],
    ["Urushning sababi", "Fors davlati Yunonistonni bosib olmoqchi bo‘lgan."],
    ["Marafon jangi qachon bo‘lgan?", "Mil. avv. 490-yilda."],
    ["Marafonda kim g‘alaba qozondi?", "Afinaliklar."],
    ["Marafon yugurishi qayerdan kelib chiqqan?", "Chopar g‘alaba xabarini Afinaga yugurib yetkazgan."],
    ["Doro I dan keyin yurishni kim davom ettirdi?", "Uning o‘g‘li Kserks."],
    ["Fermopil jangi qachon bo‘lgan?", "Mil. avv. 480-yilda."],
    ["Fermopil darasi", "Yunoniston shimolidan janubiga olib boradigan yagona yo‘l."],
    ["Fermopilda kim qahramonlarcha halok bo‘ldi?", "Sparta podshosi Leonid va 300 spartalik."],
    ["Salamin jangi", "Salamin bo‘g‘ozidagi hal qiluvchi dengiz jangi (mil. avv. 480)."],
    ["Triyera", "Yunon harbiy kemasi."],
    ["Salaminda yunonlarning nechta kemasi bo‘lgan?", "Taxminan 200 ta."],
    ["Plateya jangi qachon bo‘lgan?", "Mil. avv. 479-yilda."],
    ["Plateyada nima bo‘ldi?", "Yunonlarning birlashgan qo‘shini fors quruqlik qo‘shinini yengdi."],
    ["Urush qachon tugadi?", "Mil. avv. 449-yilda sulh bilan."],
    ["Yunon-fors urushlari natijasi", "Yunonlarning to‘liq g‘alabasi."],
    ["480-yilda qaysi ikki jang bo‘lgan?", "Fermopil (quruqlikda) va Salamin (dengizda)."],
    ["«Ma-Fe-Sa-Pla»", "Janglar tartibi: Marafon, Fermopil, Salamin, Plateya."],
    ["Leonid", "300 spartalik bilan Fermopilda jang qilgan Sparta podshosi."],
    ["Kserks", "Doro I ning o‘g‘li, Yunonistonga yurish qilgan fors shohi."]
  ],
  "26": [
    ["Yunoniston nega zaiflashdi?", "Yunon shaharlari, ayniqsa Afina va Sparta o‘zaro urushgan."],
    ["Makedoniya qayerda?", "Yunonistonning shimolida."],
    ["Yunonistonni bosib olgan Makedoniya podshosi", "Filipp II."],
    ["Filipp II qo‘shini", "Kuchli otliqlar va 16 qatorli falanga."],
    ["Makedon falangasi necha qatorli bo‘lgan?", "16 qatorli."],
    ["Falanganing oltinchi qator jangchilari", "Juda uzun nayzalar ushlagan."],
    ["Demosfen", "Yunonlarni Makedoniyaga qarshi birlashishga chaqirgan afinalik notiq."],
    ["Filippikalar", "Demosfenning Filippga qarshi nutqlari."],
    ["Xeroniya jangi qachon bo‘lgan?", "Mil. avv. 338-yilda."],
    ["Xeroniyada kim g‘alaba qozondi?", "Filipp II."],
    ["Xeroniya jangining natijasi", "Yunoniston mustaqilligini yo‘qotdi."],
    ["Korinf ittifoqi qachon tuzildi?", "Mil. avv. 337-yilda."],
    ["Korinf ittifoqining mohiyati", "Yunon shaharlari Makedoniyaga bo‘ysundi."],
    ["Korinf ittifoqida nizolarni kim hal qilgan?", "Shahar-davlatlar kengashi."],
    ["Notiq", "Xalq oldida nutq so‘zlovchi, so‘z ustasi."],
    ["«Filipp — Falanga, Xeroniya — Xavf»", "Filippning kuchi falangada, Xeroniya yunonlar uchun halokatli bo‘ldi."],
    ["338 va 337 yillar", "Bir yil ichida jang (Xeroniya) va ittifoq (Korinf)."],
    ["Makedon qo‘shinining kuchi nimada edi?", "Kuchli otliqlar va zich falangada."],
    ["Yunon-fors urushlaridan keyin qaysi polislar urushdi?", "Afina va Sparta."],
    ["Filipp II nimadan foydalandi?", "Yunon shaharlarining o‘zaro urushib zaiflashganidan."]
  ],
  "27": [
    ["Afinada bolalar necha yoshdan maktabga borgan?", "7 yoshdan (boy oila farzandlari)."],
    ["«Pedagog» so‘zining asl ma’nosi", "Bolani yo‘lda kuzatib boruvchi."],
    ["Qadimgi pedagog kim bo‘lgan?", "Bolani maktabga olib borib keladigan qul."],
    ["Maktabda qaysi fanlar o‘qitilgan?", "O‘qish, yozish, hisob, musiqa va she’r."],
    ["Maktabda qaysi she’rlar o‘rganilgan?", "Gomer dostonlari."],
    ["Yunon o‘quvchilari nimaga yozishgan?", "Mum surtilgan taxtachaga."],
    ["Stil", "Mumli taxtachaga yozish uchun metall tayoqcha."],
    ["Palestra", "Kurash maktabi — jismoniy tarbiya joyi."],
    ["Yigitlar necha yil harbiy ta’lim olgan?", "Ikki yil."],
    ["Harbiy ta’limning birinchi yili", "Saf, qurol va chidamlilik mashqlari."],
    ["Harbiy ta’limning ikkinchi yili", "Chegara qal’alarida xizmat yoki dengizchilik."],
    ["Har bir fuqaroning burchi", "Vatanga muhabbat."],
    ["Olimpiya o‘yinlari kim sharafiga o‘tkazilgan?", "Zevs sharafiga."],
    ["Birinchi Olimpiya o‘yinlari qachon?", "Mil. avv. 776-yilda."],
    ["Olimpiya g‘oliblari mukofoti", "Zaytun novdasidan to‘qilgan gulchambar."],
    ["Yunonlar yilni qanday hisoblagan?", "Olimpiadalar bo‘yicha."],
    ["Olimpiya o‘yinlari qachon taqiqlangan?", "Milodiy 394-yilda."],
    ["Olimpiya o‘yinlari nega taqiqlangan?", "Xristianlik tarqalgani sababli."],
    ["Olimpiya o‘yinlari qachon qayta tiklangan?", "1896-yilda."],
    ["«Disk uloqtiruvchi» haykali muallifi", "Miron."]
  ],
  "28": [
    ["Gomer", "Qadimgi yunon shoiri, «Iliada» va «Odisseya» muallifi."],
    ["«Iliada» nima haqida?", "Troya urushining oxirgi, o‘ninchi yili haqida."],
    ["«Odisseya» nima haqida?", "Odisseyning uyga qaytish sarguzashtlari haqida."],
    ["Yunonlar Troyani necha yil behuda qamal qilgan?", "9 yil."],
    ["Troya oti", "Ichiga jangchilar yashirilgan ulkan yog‘och ot."],
    ["Troya oti kimning maslahati bilan yasalgan?", "Odisseyning."],
    ["«Axilles tovoni» iborasi", "Kishining eng zaif joyi."],
    ["Nega «Axilles tovoni» deyiladi?", "Qahramon Axillesning yagona zaif joyi tovoni bo‘lgan."],
    ["Troyani kim topgan?", "Nemis olimi Genrix Shliman."],
    ["Shliman Troyani qachon topdi?", "XIX asr oxirida."],
    ["Shliman Troyani qanday topdi?", "Gomer asarlarini o‘rganib."],
    ["«Teatr» so‘zining ma’nosi", "Yunoncha «tomoshalar joyi»."],
    ["Teatr qachon paydo bo‘lgan?", "Bundan 2,5 ming yil oldin, Yunonistonda."],
    ["Tragediya ustasi", "Sofokl."],
    ["Komediya ustasi", "Aristofan."],
    ["Parfenon", "Afina Akropolidagi ma’buda Afinaga bag‘ishlangan ibodatxona."],
    ["Fidiy", "Parfenon bezaklari va Zevs haykali muallifi bo‘lgan haykaltarosh."],
    ["Olimpiyadagi Zevs haykali", "Dunyoning yetti mo‘jizasidan biri."],
    ["Teatr tomoshalari qachon ko‘rsatilgan?", "Bayramlarda."],
    ["«Sofokl — Sokin yig‘i, Aristofan — Ajoyib kulgi»", "Sofokl — tragediya, Aristofan — komediya ustasi."]
  ],
  "29": [
    ["«Faylasuf» so‘zining ma’nosi", "«Donolikni sevuvchi»."],
    ["Faylasuflar nima qilishga uringan?", "Olam qanday tuzilganini aql bilan tushuntirishga."],
    ["Geraklit ta’limoti", "Hamma narsa olovdan kelib chiqqan, dunyo doim o‘zgaradi."],
    ["Demokrit ta’limoti", "Hamma narsa mayda zarrachalar — atomlardan tashkil topgan."],
    ["Diogen", "Boylikdan voz kechib, bochkada yashagan faylasuf."],
    ["Diogenning mashhur so‘zi", "«Shuncha narsasiz ham yashash mumkinligi naqadar ajoyib!»"],
    ["Suqrot haqiqatni qanday izlagan?", "Savol-javob orqali."],
