  ],
  "32": [
    ["Ahamoniylar davridagi shaharlar", "Qiziltepa, Yerqo‘rg‘on, Uzunqir, Afrosiyob."],
    ["Shaharlarning tuzilishi", "Har birida ichki qal’a bo‘lgan."],
    ["Dastlabki tanga pullar qachon tarqaldi?", "Mil. avv. V–IV asrlarda."],
    ["Amudaryo xazinasi", "Zargarlik rivojini ko‘rsatuvchi mashhur topilma."],
    ["Amudaryo xazinasi qachon topilgan va hozir qayerda?", "1877-yilda topilgan, hozir Britaniya muzeyida."],
    ["Akinak", "Kalta qilich."],
    ["Sagaris", "Jangovar bolta."],
    ["Aleksandr Sharqqa yurishni qachon boshladi?", "Mil. avv. 334-yilda."],
    ["Bess", "Aleksandrga qarshilik qilmoqchi bo‘lgan Baqtriya satrapi."],
    ["Aleksandrning O‘rta Osiyodagi yo‘li", "Baqtra → Naytaka → Maroqanda."],
    ["Maroqanda qachon egallandi?", "Mil. avv. 329-yilda."],
    ["Aleksandriya Esxata", "«Chekka Aleksandriya» — Sirdaryo bo‘yida, Xo‘jand yaqinidagi qal’a."],
    ["Spitamen", "Qo‘zg‘olonga boshchilik qilgan So‘g‘d zodagoni."],
    ["Spitamen qaysi shaharni qamal qildi?", "Maroqandani."],
    ["Aleksandr yordamga qancha qo‘shin yubordi?", "Taxminan 3 ming kishilik qo‘shin."],
    ["Spitamenning mashhur g‘alabasi", "Politimet (Zarafshon) bo‘yida pistirma qo‘yib, makedon qo‘shinini qirib tashladi."],
    ["Politimet", "Zarafshon daryosining qadimgi nomi."],
    ["Spitamen kurashi qancha davom etdi?", "3 yil."],
    ["Spitamen qachon halok bo‘ldi?", "Mil. avv. 328-yilda, xiyonat tufayli."],
    ["«Politimet — Pistirma» hiylasi", "Spitamenning g‘alabasi Zarafshon bo‘yida bo‘lganini eslatadi."]
  ],
  "33": [
    ["Aleksandr qachon vafot etdi?", "Mil. avv. 323-yilda."],
    ["Aleksandr davlati qaysi qismlarga bo‘lindi?", "Makedoniya, Misr va Suriya."],
    ["O‘rta Osiyo qaysi qismga kirdi?", "Suriya — ya’ni Salavkiylar davlatiga."],
    ["Salavkiylar davlatiga kim asos solgan?", "Sarkarda Salavk."],
    ["Salavkiylar tarkibidagi hududlar", "Parfiya, Baqtriya, So‘g‘diyona, Marg‘iyona."],
    ["Salavkiylar boshqaruvi", "Yer satrapliklarga bo‘lingan, qo‘shinni strateglar boshqargan."],
    ["Ellinizm", "Mahalliy va yunon madaniyatlarining qo‘shilishi."],
    ["Diodot", "Yunon-Baqtriya davlati asoschisi, «ming shahar hukmdori»."],
