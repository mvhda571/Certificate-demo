    ["Diodotdan keyingi hukmdor", "Yevtidem."],
    ["Demetriy", "Yevtidemning o‘g‘li; uning davrida Yunon-Baqtriya eng katta hududga ega bo‘ldi."],
    ["Demetriy davrida qaysi hudud qo‘shildi?", "Hindistonning bir qismi."],
    ["Yunon-Baqtriyani nima zaiflashtirdi?", "Parfiya bilan tinimsiz urushlar."],
    ["Parfiya hukmdori", "Mitridat I."],
    ["Yunon-Baqtriyani kim bosib oldi?", "Ko‘chmanchi yuechji qabilalari."],
    ["Yuechjilar Yunon-Baqtriyani qachon bosib oldi?", "Mil. avv. 140–130-yillarda."],
    ["«D-Y-D» hiylasi", "Diodot → Yevtidem → Demetriy."],
    ["Strateg (Salavkiylarda)", "Qo‘shinni boshqargan harbiy boshliq."],
    ["Salavkiylar davrida hunarmandchilik va savdo", "Qayta tiklandi."]
  ],
