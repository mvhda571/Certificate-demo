    ["Yunon xudolari qayerda yashagan?", "Olimp tog‘ida."],
    ["Zevs", "Bosh xudo, chaqmoq va osmon xudosi."],
    ["Poseydon", "Dengiz xudosi."],
    ["Aid", "Marhumlar saltanati xudosi."],
    ["Afina (ma’buda)", "Donolik ma’budasi."],
    ["Apollon", "San’at va quyosh xudosi."],
    ["Gefest", "Temirchilik va hunarmandchilik xudosi."],
    ["Titanlar", "Yunon afsonalaridagi afsonaviy mavjudotlar."],
    ["Kentavr", "Yarim odam, yarim ot ko‘rinishidagi mavjudot."],
    ["Siklop", "Bir ko‘zli dev."],
    ["Gerakl", "Zevsning o‘g‘li, eng kuchli qahramon."],
