    ["Qang‘ga kim asos solgan?", "Mil. avv. III asrda saklar."],
    ["Qang‘ markazi", "Sirdaryo o‘rta oqimi, Toshkent vohasi."],
    ["Qanqa (Qang‘xa)", "Toshkent vohasidagi shahar-qal’a, mil. avv. III asrda asos solingan."],
    ["Davan qayerda joylashgan?", "Hozirgi Farg‘ona vodiysida."],
    ["Davan qaysi davrda mavjud bo‘lgan?", "Mil. avv. III asr – milodiy III asr."],
    ["Davan poytaxti", "Ershi."],
    ["Davan shaharlari", "Ershi, Sho‘rabashat, Uchqo‘rg‘on."],
    ["Davan nima bilan mashhur?", "«Samoviy otlar» bilan."],
    ["Xitoy imperatori nega Davanga yurish qildi?", "«Samoviy otlar»ni olish uchun."]
  ],
  "35": [
    ["Yuechjilar Baqtriyaga qachon keldi?", "Mil. avv. 140–130-yillarda."],
    ["Yuechjilar nechta mulkka bo‘lingan?", "Beshta."],
