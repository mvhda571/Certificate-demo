  "44": [
    ["Rim dunyoga nimalarni qoldirdi?", "Lotin tili, rim raqamlari, yo‘llar, akveduklar, Panteon va Kolizey."],
    ["Rimda kimlar maktabda o‘qigan?", "Boy oilalar farzandlari."],
    ["Kambag‘al oilalar farzandlari nima qilgan?", "Ota-onasiga ishda yordam bergan."],
    ["Stil (Rimda)", "Mum qoplangan taxtachaga yozish uchun temir tayoqcha."],
    ["Lotin tilining ahamiyati", "Keyinchalik Yevropa tillari va fanining asosi bo‘ldi."],
    ["Rim raqamlari", "I, V, X kabi raqamlar — hozir ham ishlatiladi."],
    ["Rim binolarining o‘ziga xosligi", "Rang-barangligi va muhtashamligi."],
    ["Rim me’moriy uslublari", "Doriy, ion, korinf va aralash."],
    ["«Hamma yo‘llar Rimga olib boradi»", "Rimliklar yo‘l qurishda usta bo‘lganini ko‘rsatadi."],
    ["Panteon", "Barcha xudolar ibodatxonasi."],
    ["«Panteon» so‘zining ma’nosi", "«Pan» (hamma) + «teon» (xudo)."],
    ["Panteonning xususiyati", "Imperiyadagi har kim o‘z xudosiga sig‘inishi mumkin bo‘lgan."],
    ["Kolizey", "Gladiatorlar janglari o‘tgan amfiteatr."],
    ["Milodiy I asrda Rim shahri", "Eng yirik va aholisi eng ko‘p shaharga aylangan."],
    ["Rim tarixchilari", "Tit Liviy, Plutarx, Kvint Kursiy Ruf."],
    ["Kvint Kursiy Ruf nega muhim?", "U Aleksandr yurishlari haqida yozgan — O‘rta Osiyo tarixi uchun muhim manba."],
    ["Xristianlik qachon paydo bo‘ldi?", "Milodiy I asrda."],
    ["Xristianlik qayerda paydo bo‘ldi?", "Rim hokimiyati ostidagi Falastinda."],
    ["Rivoyatga ko‘ra Iso qayerda tug‘ilgan?", "Vifleem shahrida."],
    ["Xristianlik", "Iso Masih ta’limotiga asoslangan din."]
  ]
