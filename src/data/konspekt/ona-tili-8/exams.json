{
  "midterm": [
    { "t": 1, "q": "«G‘urur» so‘zining ma’nosi qaysi?", "o": ["O‘zini boshqalardan ustun qo‘yish", "O‘z qadrini bilish", "Manmanlik", "Hasad"], "a": 1, "e": "Ijobiy tushuncha." },
    { "t": 2, "q": "Ilmiy uslubda nima kam qo‘llanadi?", "o": ["Termin", "Ko‘chma ma’no", "Ta’rif", "Dalil"], "a": 1, "e": "Ilmiy asar va darsliklar." },
    { "t": 2, "q": "Qaysi uslubda me’yorlarga qat’iy rioya qilinmaydi?", "o": ["Rasmiy", "So‘zlashuv", "Ilmiy", "Publitsistik"], "a": 1, "e": "Oila, ko‘cha-ko‘yda." },
    { "t": 3, "q": "Ravishning nechta ma’no turi bor?", "o": ["Uchta", "Beshta", "Yettita", "To‘rtta"], "a": 1, "e": "Holat, payt, o‘rin, miqdor-daraja, maqsad-sabab." },
    { "t": 4, "q": "Ma’lumotnoma matniga xos xususiyat?", "o": ["Badiiy vositalar", "Xolislik", "Sub’ektivlik", "Obrazlilik"], "a": 1, "e": "Aqlga yo‘naltirilgan." },
    { "t": 5, "q": "Sinov inshosi qachon yoziladi?", "o": ["Har dars", "Chorak yoki yil oxirida", "Uyda", "Yozgi ta’tilda"], "a": 1, "e": "O‘qituvchi nazoratida." },
    { "t": 6, "q": "Ilmiy inshoda tasviriy vositalar qanday?", "o": ["Juda ko‘p", "Deyarli yo‘q", "Faqat o‘xshatish", "Majburiy"], "a": 1, "e": "Ilmiy dalillarga asoslanadi." },
    { "t": 7, "q": "Insho rejasining xulosa qismida nima bo‘ladi?", "o": ["Mavzu haqida umumiy fikr", "Asosiy qismdan kelib chiqadigan lo‘nda fikr", "Epigraf", "Manbalar ro‘yxati"], "a": 1, "e": "Kirish — umumiy fikr." },
    { "t": 9, "q": "Epigraf muallifi qanday beriladi?", "o": ["Qo‘shtirnoqda", "Qavs ichida", "Tire bilan", "Bosh harf bilan"], "a": 1, "e": "Sahifaning o‘ng chekkasida." },
    { "t": 11, "q": "So‘z birikmasida tobe so‘z qayerda keladi?", "o": ["Keyin", "Oldin", "O‘rtada", "Istalgan joyda"], "a": 1, "e": "Hokim so‘z keyin." },
    { "t": 12, "q": "«Hammasidan katta» qanday birikma?", "o": ["Fe’lli", "Otli", "Teng", "Qo‘shma so‘z"], "a": 1, "e": "Hokim so‘z sifat." },
    { "t": 13, "q": "«Kitob va daftar» qanday birlik?", "o": ["So‘z birikmasi", "So‘z qo‘shilmasi", "Qo‘shma so‘z", "Ibora"], "a": 1, "e": "Teng bog‘lanish." },
    { "t": 14, "q": "Gapning nechta asosiy belgisi bor?", "o": ["Ikkita", "Uchta", "To‘rtta", "Beshta"], "a": 1, "e": "Tugal fikr, ohang, kesimlik." },
    { "t": 15, "q": "«Kitobni o‘qi!» qanday gap?", "o": ["Darak", "Buyruq", "So‘roq", "Istak"], "a": 1, "e": "Buyruq-istak mayli." },
    { "t": 16, "q": "Qo‘shma gapni aniqlash uchun nimani sanash kerak?", "o": ["Egalarni", "Shakllangan kesimlarni", "Hollarni", "So‘zlarni"], "a": 1, "e": "Birdan ortiq — qo‘shma gap." },
    { "t": 18, "q": "«Savobning eshigi ko‘p» gapida kesim qaysi turkum?", "o": ["Sifat", "Ravish", "Son", "Fe’l"], "a": 1, "e": "Ot kesim." },
    { "t": 20, "q": "«Bilar ekan» ning qisqa shakli?", "o": ["Bilarekan", "Bilarkan", "Bilaykan", "Bilarakan"], "a": 1, "e": "Edi, ekan, emish qo‘shib yozilishi mumkin." },
    { "t": 22, "q": "Qaysi gapda tire qo‘yilmaydi?", "o": ["Maqsadimiz — o‘qish", "Bizning sinfimiz sakkizinchi", "Bu — siz uchun sinov", "Uch karra uch — to‘qqiz"], "a": 1, "e": "Kesim tartib son." },
    { "t": 24, "q": "«Bugungi ishni ertaga qo‘yma» qanday gap?", "o": ["Shaxsi ma’lum", "Shaxsi umumlashgan", "Shaxsi noma’lum", "Atov"], "a": 1, "e": "Maqollarga xos." },
    { "t": 27, "q": "«Erta bahor qishlog‘imizga quvonch bilan keldi» qanday gap?", "o": ["Yig‘iq", "Yoyiq", "Atov", "To‘liqsiz"], "a": 1, "e": "Ikkinchi darajali bo‘laklar bor." }
