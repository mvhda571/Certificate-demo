  "final": [
    { "t": 2, "q": "Ko‘p shevali millatning yaxlitligini nima ta’minlaydi?", "o": ["Sheva nutqi", "Adabiy nutq", "Jargon", "Lahja"], "a": 1, "e": "Qat’iy qoidalashtirilgan." },
    { "t": 3, "q": "Olmoshning nechta ma’no turi bor?", "o": ["Beshta", "Yettita", "Uchta", "Oltita"], "a": 1, "e": "Kishilik, o‘zlik, ko‘rsatish, so‘roq, belgilash, gumon, bo‘lishsizlik." },
    { "t": 5, "q": "Insho qanday mehnat mahsuli?", "o": ["Jismoniy", "Aqliy", "Jamoaviy", "Mexanik"], "a": 1, "e": "Ijodiy mehnatning oliy ko‘rinishi." },
    { "t": 8, "q": "Rasm asosidagi hikoya insho hisoblanadimi?", "o": ["Ha", "Yo‘q", "Faqat 8-sinfda", "Faqat erkin mavzuda"], "a": 1, "e": "Maxsus reja talab qilmaydi." },
    { "t": 10, "q": "Ilmiy insho uchun nima zarur?", "o": ["Obrazli tasvir", "Fan bo‘yicha bilim va dalillar", "She’riy parcha", "Shaxsiy kechinma"], "a": 1, "e": "Termin va dalillar." },
    { "t": 11, "q": "«O‘qidi va yozdi» birikmami?", "o": ["Ha, fe’lli birikma", "Yo‘q, teng bog‘lanish", "Ha, otli birikma", "Qo‘shma so‘z"], "a": 1, "e": "Teng bog‘langan so‘zlar." },
    { "t": 12, "q": "«Ohista gapirish» qanday birikma?", "o": ["Otli", "Fe’lli", "Teng", "Ibora"], "a": 1, "e": "Hokim so‘z — harakat nomi." },
    { "t": 15, "q": "Buyruq gap oxirida qanday belgi qo‘yiladi?", "o": ["Faqat so‘roq", "Nuqta yoki undov", "Ikki nuqta", "Tire"], "a": 1, "e": "Buyurish maqsadi." },
    { "t": 17, "q": "Ikkinchi darajali bo‘laklar qaysilar?", "o": ["Ega va kesim", "To‘ldiruvchi, aniqlovchi, hol", "Undalma va kiritma", "Ega va hol"], "a": 1, "e": "Bosh bo‘laklarni izohlaydi." },
    { "t": 18, "q": "«Ko‘chada odam g‘ij-g‘ij» gapida kesim qaysi turkum?", "o": ["Undov", "Taqlid so‘z", "Ravish", "Sifat"], "a": 1, "e": "Ot kesim." },
    { "t": 19, "q": "«Yoza boshladi» qanday kesim?", "o": ["Sodda", "Murakkab", "Ot kesim", "Kesim emas"], "a": 1, "e": "Ko‘makchi fe’l bilan." },
    { "t": 20, "q": "Qaysi modal so‘z bog‘lama vazifasida keladi?", "o": ["Albatta", "Lozim", "Ehtimol", "Balki"], "a": 1, "e": "Kerak, zarur, darkor, lozim." },
    { "t": 21, "q": "Ibora bilan ifodalangan kesim qanday kesim?", "o": ["Sodda", "Murakkab", "Fe’l kesim", "Ajratilgan"], "a": 1, "e": "Yaxlit bo‘lak." },
    { "t": 22, "q": "«Bu — kitob» gapida tire nima uchun qo‘yilgan?", "o": ["Kesim sifat", "Ega ko‘rsatish olmoshi", "Ega uyushiq", "Kesim ravish"], "a": 1, "e": "Bog‘lamasiz ot kesim." },
    { "t": 23, "q": "«Yaxshilar ko‘paysin» gapida ega nima bilan ifodalangan?", "o": ["Ot", "Otlashgan sifat", "Fe’l", "Olmosh"], "a": 1, "e": "Yaxshilar." },
    { "t": 25, "q": "Atov gap qaysi egasiz gap turiga kiradi?", "o": ["Shaxsi ma’lum", "Shaxsi noma’lum", "Shaxsi umumlashgan", "Hech qaysi"], "a": 1, "e": "So‘z-gaplar ham." },
    { "t": 26, "q": "«Labbay» qanday gap?", "o": ["Atov", "So‘z-gap", "Yig‘iq", "To‘liqsiz"], "a": 1, "e": "Muomala so‘zi." },
    { "t": 28, "q": "«Ko‘p o‘qidi» gapida hol turi?", "o": ["Ravish", "Daraja-miqdor", "Payt", "O‘rin"], "a": 1, "e": "Qancha?" },
    { "t": 29, "q": "«Vatan haqida yozdi» da to‘ldiruvchi turi?", "o": ["Vositasiz", "Vositali", "Ajratilgan", "Uyushiq"], "a": 1, "e": "Ko‘makchi bilan." },
    { "t": 30, "q": "Izohlovchi aniqlovchi nimani bildiradi?", "o": ["Rang, ta’m", "Kasb, mansab, laqab, qarindoshlik", "Qarashlilik", "Miqdor"], "a": 1, "e": "Xurshid tog‘a." },
    { "t": 31, "q": "Odatdagi so‘z tartibi qaysi uslubga xos?", "o": ["She’riy", "Ilmiy va rasmiy", "So‘zlashuv", "Badiiy"], "a": 1, "e": "Inversiya — og‘zaki va she’riy nutqda." },
    { "t": 32, "q": "Bir gapda odatda nechta mantiqiy urg‘u bo‘ladi?", "o": ["Ikkita", "Bitta", "Uchta", "Urg‘u bo‘lmaydi"], "a": 1, "e": "Asosiy fikrni ta’kidlaydi." },
    { "t": 33, "q": "To‘liqsiz gap qaysi uslubga xos?", "o": ["Rasmiy", "So‘zlashuv", "Ilmiy", "Qonunchilik"], "a": 1, "e": "Dialogda ko‘p uchraydi." },
    { "t": 34, "q": "Bog‘lovchisiz uyushiq bo‘laklar orasiga nima qo‘yiladi?", "o": ["Tire", "Vergul", "Ikki nuqta", "Qavs"], "a": 1, "e": "Sanash ohangi bilan." },
    { "t": 35, "q": "«Uylar, daraxtlar, ko‘chalar — hammasi qorong‘ilikka cho‘mdi» da «hammasi» nima?", "o": ["Undalma", "Umumlashtiruvchi so‘z", "Kiritma", "Ajratilgan bo‘lak"], "a": 1, "e": "Uyushiq bo‘laklardan keyin — oldidan tire." },
    { "t": 36, "q": "Ajratilgan bo‘lakning boshqa nomi?", "o": ["Uyushiq bo‘lak", "Izoh bo‘lak", "Kiritma", "Undalma"], "a": 1, "e": "Izohlanmishni izohlaydi." },
    { "t": 37, "q": "«Mening o‘z muhabbatim bor — toza va musaffo!» gapida tire nima uchun?", "o": ["Ega va kesim orasida", "Uyushib gap oxirida kelgan ajratilgan bo‘lak oldidan", "Undalmadan keyin", "Kiritmadan keyin"], "a": 1, "e": "Ajratilgan bo‘laklar tinish belgilari." },
    { "t": 38, "q": "«Demak» kiritmasi nimani bildiradi?", "o": ["Gumon", "Xulosa", "Fikr manbai", "Tartib"], "a": 1, "e": "Shuningdek, aksincha." },
    { "t": 39, "q": "Undalma qaysi kelishikda bo‘ladi?", "o": ["Tushum", "Bosh", "Jo‘nalish", "Qaratqich"], "a": 1, "e": "Gap bo‘lagi hisoblanmaydi." },
    { "t": 40, "q": "Ma’lumotnomada qaysi ibora bo‘ladi?", "o": ["«Sizni taklif qilamiz»", "«... so‘ralgan manzil uchun berildi»", "«Iltimos qilaman»", "«Tushuntirib beraman»"], "a": 1, "e": "Tashkilot beradi, muhr bilan." }
