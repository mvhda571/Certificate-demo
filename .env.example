# Google Cloud Console > APIs & Services > Credentials > OAuth 2.0 Client ID
# Authorized JavaScript origins:
# http://localhost:5173
# https://your-domain.com
# Popup callback rejimida redirect URI talab qilinmaydi.
VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# AI Tutor: server-side Groq API key. Never expose this value to the frontend.
GROQ_API_KEY=
# Optional OpenAI-compatible Groq API endpoint.
GROQ_BASE_URL=https://api.groq.com/openai/v1
# Optional model overrides. Try another model with: npm run tutor:ask -- "savol" --model=<id>
# Tested: openai/gpt-oss-120b (best), openai/gpt-oss-20b, qwen/qwen3.8-27b.
GROQ_MODEL=openai/gpt-oss-120b
# Web search uses the browser_search tool of gpt-oss models (groq/compound is used only if your account has it).
GROQ_SEARCH_MODEL=openai/gpt-oss-120b
# Model for questions with images (must accept image input).
GROQ_VISION_MODEL=qwen/qwen3.8-27b
# Speech-to-text model for voice questions (/api/transcribe).
GROQ_TRANSCRIBE_MODEL=whisper-large-v3-turbo

# --- AI Tutor: daily question limit (checked on the server) ---
# Questions per student per day; resets at 00:00 Tashkent time (UTC+5). Default 10.
TUTOR_DAILY_LIMIT=10
# Comma-separated emails with no limit. Works only for students signed in with Google
# (the email comes from a verified Google token).
TUTOR_UNLIMITED_EMAILS=
# Upstash Redis REST credentials (upstash.com > your database > REST API).
# If empty, counters are kept in memory (fine for local dev, not for production).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Google OAuth client ID used to verify Google ID tokens on the server.
# Optional: falls back to VITE_GOOGLE_CLIENT_ID.
GOOGLE_CLIENT_ID=
