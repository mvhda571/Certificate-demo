# Google Cloud Console > APIs & Services > Credentials > OAuth 2.0 Client ID
# Authorized JavaScript origins:
# http://localhost:5173
# https://your-domain.com
# Popup callback rejimida redirect URI talab qilinmaydi.
VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# AI Tutor: server-side Groq API key. Never expose this value to the frontend.
GROQ_API_KEY=
# Optional OpenAI-compatible Groq API endpoint.
GROQ_BASE_URL=https://api.groq.com/openai/v1
# Optional model overrides for tutoring and web-enabled answers.
GROQ_MODEL=openai/gpt-oss-120b
GROQ_SEARCH_MODEL=groq/compound
